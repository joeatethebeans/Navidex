@page "/settings/webhooks"
@layout SettingsLayout
@using Microsoft.JSInterop
@inject MelodexClient Api
@inject IJSRuntime Js

<PageTitle>Webhooks · Melodex</PageTitle>

<p class="muted">
    Melodex can tell other apps when something happens, such as a request reaching your library, by posting the event to an address.
    Each post is signed with the webhook's secret, and tried again for several hours if the app doesn't take it.
</p>

@if (_webhooks is null)
{
    <Loading />
}
else
{
    <section class="panel" aria-label="Webhooks">
        <header class="panel-head">
            <div class="panel-title">
                <h2>Webhooks</h2>
                <p class="muted small">The client guide explains the events and how to check the signature.</p>
            </div>
            <button class="primary small" @onclick="() => Edit(null)">Add</button>
        </header>
        @if (_webhooks.Count == 0)
        {
            <div class="panel-empty muted small">No webhooks yet.</div>
        }
        else
        {
            <div class="plugin-grid">
                @foreach (var webhook in _webhooks)
                {
                    var last = webhook.LastDelivery;
                    <div class="plugin-card @(webhook.Enabled ? "" : "off")">
                        <div class="plugin-top">
                            <strong class="ellipsis" title="@webhook.Name">@webhook.Name</strong>
                            <span class="spacer"></span>
                            @if (!webhook.Enabled)
                            {
                                <span class="badge neutral">Off</span>
                            }
                            else if (last is not null)
                            {
                                <span class="badge @DeliveryBadge(last)" title="@DeliveryTitle(last)">@DeliveryLabel(last)</span>
                            }
                        </div>
                        <div class="muted small plugin-about" title="@webhook.Url">@webhook.Url</div>
                        <div class="small muted">@(webhook.Events.Count == 0 ? "All events" : string.Join(", ", webhook.Events))</div>
                        <div class="plugin-actions">
                            <span class="spacer"></span>
                            <IconButton Icon="power" On="webhook.Enabled" Title="@(webhook.Enabled ? "On: click to turn it off" : "Off: click to turn it on")"
                                        OnClick="() => SetEnabledAsync(webhook, !webhook.Enabled)" />
                            <IconButton Icon="test" Title="Send a test event" OnClick="() => TestAsync(webhook)" />
                            <IconButton Icon="history" Title="Recent deliveries" OnClick="() => ShowDeliveriesAsync(webhook)" />
                            <IconButton Icon="key" Title="Secret" OnClick="() => _secretFor = webhook" />
                            <IconButton Icon="settings" Title="Edit" OnClick="() => Edit(webhook)" />
                            <IconButton Icon="remove" Class="remove" Title="Remove" OnClick="() => _removing = webhook" />
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    @if (_editing)
    {
        <Dialog Title="@(_editingId is null ? "Add a webhook" : "Edit webhook")" OnClose="() => _editing = false">
            <label class="field">
                <span class="field-label">Name</span>
                <input type="text" placeholder="The app it's for" @bind="_name" @bind:event="oninput" />
            </label>
            <label class="field">
                <span class="field-label">Address</span>
                <input type="text" inputmode="url" placeholder="https://example.local/hooks/melodex" @bind="_url" @bind:event="oninput" />
            </label>
            <div class="field-label">Events</div>
            <label class="dialog-choice">
                <input type="checkbox" checked="@(_events.Count == 0)" @onchange="e => { if ((bool)e.Value!) _events.Clear(); else _events = [..EventTypes.All]; }" />
                <span><strong>All events</strong><span class="muted small">Including ones added in later versions.</span></span>
            </label>
            @if (_events.Count > 0)
            {
                @foreach (var (type, help) in EventHelps)
                {
                    <label class="dialog-choice">
                        <input type="checkbox" checked="@_events.Contains(type)" @onchange="e => ToggleEvent(type, (bool)e.Value!)" />
                        <span><code>@type</code><span class="muted small">@help</span></span>
                    </label>
                }
            }
            @if (_error is not null) { <p class="error small">@_error</p> }
            <div class="toolbar dialog-buttons">
                <button @onclick="() => _editing = false">Cancel</button>
                <button class="primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_url))" @onclick="SaveAsync">Save</button>
            </div>
        </Dialog>
    }

    @if (_secretFor is { } secretFor)
    {
        <Dialog Title="@($"Secret for {secretFor.Name}")" OnClose="() => _secretFor = null">
            <p>The receiving app checks each post's <code>Melodex-Signature</code> header with this, to know it came from this Melodex.</p>
            <div class="secret-box">
                <code>@secretFor.Secret</code>
                <IconButton Icon="copy" Title="Copy" Confirm="true" OnClick="() => CopyAsync(secretFor.Secret)" />
            </div>
            @if (_error is not null) { <p class="error small">@_error</p> }
            <div class="toolbar dialog-buttons">
                <button disabled="@_busy" @onclick="() => RotateAsync(secretFor)">Make a new secret</button>
                <button class="primary" @onclick="() => _secretFor = null">Done</button>
            </div>
        </Dialog>
    }

    @if (_deliveriesFor is { } deliveriesFor)
    {
        <Dialog Title="@($"Deliveries to {deliveriesFor.Name}")" OnClose="() => _deliveriesFor = null" Class="wide">
            @if (_deliveries is null)
            {
                <Loading />
            }
            else if (_deliveries.Count == 0)
            {
                <p class="muted">Nothing sent yet.</p>
            }
            else
            {
                <div class="table-scroll">
                    <table class="table">
                        <thead><tr><th>Event</th><th>Status</th><th>Tries</th><th>When</th></tr></thead>
                        <tbody>
                            @foreach (var d in _deliveries)
                            {
                                <tr>
                                    <td><code>@d.Event</code></td>
                                    <td><span class="badge @DeliveryBadge(d)" title="@d.Error">@d.State</span> <span class="muted small">@DeliveryTitle(d)</span></td>
                                    <td>@d.Attempts</td>
                                    <td class="muted small">@Format.Ago(d.CreatedAt)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <div class="toolbar dialog-buttons"><button class="primary" @onclick="() => _deliveriesFor = null">Done</button></div>
        </Dialog>
    }

    @if (_removing is { } removing)
    {
        <Dialog Title="@($"Remove {removing.Name}?")" OnClose="() => _removing = null" Alert="true">
            <p>Melodex stops sending events there, and drops any it hasn't sent yet.</p>
            <div class="toolbar dialog-buttons">
                <button @onclick="() => _removing = null">Cancel</button>
                <button class="danger" disabled="@_busy" @onclick="() => RemoveAsync(removing)">Remove</button>
            </div>
        </Dialog>
    }

    @if (_tested is { } tested)
    {
        <div class="notice @(tested.State == WebhookDeliveryState.Delivered ? "" : "error")" role="status">
            @(tested.State == WebhookDeliveryState.Delivered ? $"The test event was delivered ({tested.ResponseStatus})." : $"The test event wasn't taken: {tested.Error}")
        </div>
    }
}

@code {
    private IReadOnlyList<WebhookInfo>? _webhooks;
    private bool _busy;
    private string? _error;

    private bool _editing;
    private Guid? _editingId;
    private string _name = "";
    private string _url = "";
    private bool _enabled = true;
    private List<string> _events = [];

    private WebhookInfo? _secretFor;
    private WebhookInfo? _removing;
    private WebhookInfo? _deliveriesFor;
    private IReadOnlyList<WebhookDeliveryInfo>? _deliveries;
    private WebhookDeliveryInfo? _tested;

    private static readonly (string Type, string Help)[] EventHelps =
    [
        (EventTypes.RequestCompleted, "A request reached your library."),
        (EventTypes.RequestFailed, "A request failed."),
        (EventTypes.RequestNeedsReview, "Nothing found passed the checks, so a request needs you to choose."),
        (EventTypes.ListenReady, "A listen-now track is ready to play."),
        (EventTypes.ScanCompleted, "A library scan finished."),
        (EventTypes.ScanFailed, "A library scan failed."),
    ];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => _webhooks = await Api.ListWebhooksAsync();

    private static string DeliveryLabel(WebhookDeliveryInfo d) => d.State switch
    {
        WebhookDeliveryState.Delivered => "Working",
        WebhookDeliveryState.Pending => "Retrying",
        _ => "Failing",
    };

    private static string DeliveryBadge(WebhookDeliveryInfo d) => d.State switch
    {
        WebhookDeliveryState.Delivered => "owned",
        WebhookDeliveryState.Pending => "partial",
        _ => "missing",
    };

    private static string DeliveryTitle(WebhookDeliveryInfo d) => d.State switch
    {
        WebhookDeliveryState.Delivered => $"{d.ResponseStatus}",
        WebhookDeliveryState.Pending when d.NextAttemptAt is { } next => $"{d.Error} · next try {Format.Until(next)}",
        _ => d.Error ?? "",
    };

    private void Edit(WebhookInfo? webhook)
    {
        _editingId = webhook?.Id;
        _name = webhook?.Name ?? "";
        _url = webhook?.Url ?? "";
        _enabled = webhook?.Enabled ?? true;
        _events = webhook?.Events.ToList() ?? [];
        _error = null;
        _editing = true;
    }

    private void ToggleEvent(string type, bool on)
    {
        if (on && !_events.Contains(type))
            _events.Add(type);
        else if (!on)
            _events.Remove(type);
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var body = new SaveWebhook(_name, _url, EventTypes.All.Where(_events.Contains).ToList(), _enabled);
            if (_editingId is { } id)
                await Api.UpdateWebhookAsync(id, body);
            else
                await Api.CreateWebhookAsync(body);
            _editing = false;
            await LoadAsync();
        }
        catch (MelodexApiException e)
        {
            _error = e.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetEnabledAsync(WebhookInfo webhook, bool enabled)
    {
        await Api.UpdateWebhookAsync(webhook.Id, new SaveWebhook(webhook.Name, webhook.Url, webhook.Events, enabled));
        await LoadAsync();
    }

    private async Task TestAsync(WebhookInfo webhook)
    {
        _tested = await Api.TestWebhookAsync(webhook.Id);
        await LoadAsync();
    }

    private async Task ShowDeliveriesAsync(WebhookInfo webhook)
    {
        _deliveriesFor = webhook;
        _deliveries = null;
        _deliveries = await Api.ListWebhookDeliveriesAsync(webhook.Id);
    }

    private async Task RotateAsync(WebhookInfo webhook)
    {
        _busy = true;
        _error = null;
        try
        {
            _secretFor = await Api.RotateWebhookSecretAsync(webhook.Id);
            await LoadAsync();
        }
        catch (MelodexApiException e)
        {
            _error = e.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveAsync(WebhookInfo webhook)
    {
        _busy = true;
        try
        {
            await Api.RemoveWebhookAsync(webhook.Id);
            _removing = null;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CopyAsync(string text) => await Js.InvokeVoidAsync("navigator.clipboard.writeText", text);
}
