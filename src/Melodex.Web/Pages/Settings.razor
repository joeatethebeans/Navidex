@page "/settings"
@layout SettingsLayout
@inject MelodexClient Api

<PageTitle>Settings · Melodex</PageTitle>


@if (_settings is null || _fetch is null || _log is null)
{
    <Loading />
}
else
{
    <h2>Songs on more than one release</h2>
    <p class="muted small">
        A song is often on several releases: an album and its singles, a standard and a deluxe edition, an EP, a compilation, a soundtrack.
        This decides whether it's fetched once or for each, and whether owning it on any one of them counts for all the others.
    </p>
    <div class="card settings-card">
        @foreach (var (value, label, help) in DuplicateOptions)
        {
            <label class="dialog-choice">
                <input type="radio" name="duplicates" checked="@(_settings.DuplicateTracks == value)" @onchange="() => _settings = _settings with { DuplicateTracks = value }" />
                <span><strong>@label</strong><span class="muted small">@help</span></span>
            </label>
        }
    </div>

    <h2>Missing view</h2>
    <p class="muted small">
        Which releases you don't have are listed as missing. A release can be more than one kind, such as a live compilation, and then
        follows the strictest. <strong>New songs only</strong> lists a release just for the songs that aren't on a release shown in full or
        one you have (the same recording, or the same title leaving aside notes like "(Live)"), and only those count as missing. Their songs are
        looked up at the next scan, so they show from then.
    </p>
    <div class="card settings-card release-kinds">
        @foreach (var (heading, note, kinds) in KindGroups)
        {
            <div class="release-group">
                <div class="release-group-head">
                    <h3>@heading</h3>
                    <span class="muted small">@note</span>
                </div>
                @foreach (var (kind, name, hint) in kinds)
                {
                    var showing = _settings.ShowingOf(kind);
                    <div class="release-row">
                        <span class="release-name">@name@if (hint is not null) { <span class="muted small">@hint</span> }</span>
                        <Segmented T="ReleaseShowing" Value="showing" Options="ShowingOptions" Label="@name" Class="@($"showing {showing.ToString().ToLowerInvariant()}")"
                                   OnChange="value => SetShowing(kind, value)" />
                    </div>
                }
            </div>
        }
        @if (!IsDefaultShowing)
        {
            <button class="link small" @onclick="ResetShowing">Back to the defaults: albums, EPs and singles in full, nothing else</button>
        }
    </div>

    <h2>Matching</h2>
    <div class="card settings-card">
        <div class="setting-line">
            Send fuzzy matches under
            <NumberField Min="50" Max="100" Label="Confidence, in percent" Value="(int)Math.Round(_settings.MatchThreshold * 100)"
                         ValueChanged="n => _settings = _settings with { MatchThreshold = n / 100.0 }" />
            % confidence to review
        </div>
        <div class="muted small">Applies from the next scan.</div>
        <div class="setting-line">
            When MusicBrainz is busy, try each album
            <NumberField Min="1" Max="10" Label="Attempts" Value="_settings.AttemptsWhenBusy" ValueChanged="n => _settings = _settings with { AttemptsWhenBusy = n }" />
            @(_settings.AttemptsWhenBusy == 1 ? "time" : "times") before leaving it for the next scan
        </div>
        <div class="muted small">A busy album goes to the back of the queue, so MusicBrainz gets time to recover before it's tried again.</div>
    </div>

    <h2>File metadata</h2>
    <p class="muted small">How the music you have is shown. Matching, and what counts as missing, go by the catalogue either way.</p>
    <div class="card settings-card">
        <label class="dialog-choice">
            <input type="checkbox" checked="@_settings.PreferFileTags" @onchange="e => _settings = _settings with { PreferFileTags = (bool)e.Value! }" />
            <span>
                <strong>Use your files' tags</strong>
                <span class="muted small">Song titles, artists and albums as your files' tags have them, wherever a file has them; the catalogue fills in the rest.</span>
            </span>
        </label>
        <label class="dialog-choice">
            <input type="checkbox" checked="@_settings.PreferFileCovers" @onchange="e => _settings = _settings with { PreferFileCovers = (bool)e.Value! }" />
            <span>
                <strong>Use your files' cover art</strong>
                <span class="muted small">A picture embedded in the files, or one like folder.jpg beside them, wherever there's one; otherwise the catalogue's.</span>
            </span>
        </label>
        <div class="muted small">Files you exclude from matching always show as their own tags and pictures say.</div>
    </div>

    <h2>Lyrics</h2>
    <p class="muted small">Found through the lyrics plugins, set up on the <a href="settings/plugins">Plugins</a> page, and written by the beets worker.</p>
    <div class="card settings-card">
        <label class="dialog-choice">
            <input type="checkbox" checked="@_settings.FetchLyrics" @onchange="e => _settings = _settings with { FetchLyrics = (bool)e.Value! }" />
            <span>
                <strong>Find lyrics after each scan</strong>
                <span class="muted small">For songs without them. A song no source has lyrics for is asked about again after a month. Each song's page can look for them any time.</span>
            </span>
        </label>
        <div class="muted small">Where lyrics go:</div>
        @foreach (var (storage, name, hint) in LyricsStorages)
        {
            <label class="dialog-choice">
                <input type="radio" name="lyrics-storage" checked="@(_settings.LyricsStorage == storage)" @onchange="() => _settings = _settings with { LyricsStorage = storage }" />
                <span>
                    <strong>@name</strong>
                    <span class="muted small">@hint</span>
                </span>
            </label>
        }
    </div>

    <h2>Fetching</h2>
    <div class="card settings-card">
        <div class="field">
            <label class="field-label" for="path-template">Folder layout for new albums</label>
            <input id="path-template" type="text" style="width: 100%; max-width: 32rem;" @bind="_fetchTemplate" />
            <div class="muted small">
                A <a href="https://beets.readthedocs.io/en/stable/reference/pathformat.html" target="_blank" rel="noopener noreferrer">beets path format</a>.
                The default, <code>@FetchSettings.DefaultPathTemplate</code>, gives <code>Portishead/Dummy/11 Glory Box.opus</code>.
                A track for an album you already have goes next to that album's files instead.
                @if (_fetchTemplate != FetchSettings.DefaultPathTemplate)
                {
                    <button class="link small" @onclick="() => _fetchTemplate = FetchSettings.DefaultPathTemplate">Use the default</button>
                }
            </div>
        </div>
        <div class="setting-line">
            Fetch
            <NumberField Min="1" Max="8" Label="Fetches at once" Value="_fetch.ParallelFetches" ValueChanged="n => _fetch = _fetch with { ParallelFetches = n }" />
            at once
        </div>
        <div class="setting-line">
            Accept a file within
            <NumberField Min="0" Max="120" Label="Seconds" Value="_fetch.DurationToleranceSeconds" ValueChanged="n => _fetch = _fetch with { DurationToleranceSeconds = n }" />
            seconds or
            <NumberField Min="0" Max="50" Label="Percent" Value="_fetch.DurationTolerancePercent" ValueChanged="n => _fetch = _fetch with { DurationTolerancePercent = n }" />
            % of the song's length, whichever is more
        </div>
        <div class="muted small">A file further off is probably a different version, such as a live take or a radio edit.</div>
        <div class="setting-line">
            Try
            <NumberField Min="1" Max="5" Label="Results per source" Value="_fetch.CandidatesPerPlugin" ValueChanged="n => _fetch = _fetch with { CandidatesPerPlugin = n }" />
            of each source's results before moving to the next source
        </div>
        <div class="setting-line">
            Keep listen-now tracks for
            <NumberField Min="5" Max="10080" Step="5" Label="Minutes" Value="_fetch.ListenNowExpiryMinutes" ValueChanged="n => _fetch = _fetch with { ListenNowExpiryMinutes = n }" />
            minutes after they were last played
        </div>
        <div class="muted small">A track fetched to listen to, and not added to the library, is deleted after this.</div>
    </div>

    <h2>Log</h2>
    <div class="card settings-card">
        <div class="setting-line">
            Show the last
            <NumberField Min="1" Max="90" Label="Days" Value="_log!.MemoryDays" ValueChanged="n => _log = _log with { MemoryDays = n }" />
            days on the Log page
        </div>
        <div class="setting-line">
            Keep backup files for
            <NumberField Min="1" Max="3650" Label="Days" Value="_log.FileDays" ValueChanged="n => _log = _log with { FileDays = n }" />
            days
        </div>
        <div class="muted small">Every entry is written to a file per day under <code>data/logs</code> as it happens, so a restart loses nothing. Older files are deleted.</div>
    </div>

    <div class="toolbar">
        <button class="primary" @onclick="SaveAsync">Save</button>
        @if (_saved) { <span class="muted small">Saved.</span> }
        @if (_saveError is not null) { <span class="error small" title="@_saveError">@_saveError</span> }
    </div>

    <p class="muted small">Plugins (sources, the media server and the catalogue) are set up under <a href="settings/plugins">Plugins</a>.</p>
}

@code {
    private static readonly (LyricsStorage Storage, string Name, string Hint)[] LyricsStorages =
    [
        (LyricsStorage.Sidecar, "Beside each song", "An .lrc file with the song's name. Navidrome and most players read these, and the music files themselves aren't changed."),
        (LyricsStorage.Embedded, "In each song's file", "Its lyrics tag, so the lyrics travel with the file."),
        (LyricsStorage.Both, "Both", "An .lrc file beside it and its lyrics tag."),
    ];

    private LibrarySettings? _settings;
    private FetchSettings? _fetch;
    private LogSettings? _log;
    private string _fetchTemplate = "";
    private bool _saved;
    private string? _saveError;

    private static readonly (DuplicateTracks, string, string)[] DuplicateOptions =
    [
        (DuplicateTracks.KeepInAlbum, "Fetch once, keep it with the main album",
            "Owning a song on any release counts for every release it's on, so a single, EP, compilation or deluxe edition whose songs you already have shows as covered, not missing. A song fetched on its own goes with the artist's main album that has it."),
        (DuplicateTracks.KeepInSingle, "Fetch once, keep it with the smallest release",
            "As above, but a song fetched on its own goes with the smallest release that has it: a single before an EP, an EP before an album."),
        (DuplicateTracks.KeepBoth, "Fetch for every release, keep a copy in each",
            "Every release is judged on its own files: a single, EP, compilation or deluxe edition shows as missing until you have it as that release, even if you have its songs on another."),
    ];

    protected override async Task OnInitializedAsync()
    {
        _settings = await Api.GetLibrarySettingsAsync();
        _fetch = await Api.GetFetchSettingsAsync();
        _log = await Api.GetLogSettingsAsync();
        _fetchTemplate = _fetch.PathTemplate;
    }

    private static readonly IReadOnlyList<(ReleaseShowing, string, string?)> ShowingOptions =
    [
        (ReleaseShowing.Show, "Show", "List it, with every song on it"),
        (ReleaseShowing.NewSongsOnly, "New songs only", "List it only for songs that aren't on a release shown in full or one you have"),
        (ReleaseShowing.Hide, "Hide", "Don't list it"),
    ];

    private static readonly (string Heading, string Note, (ReleaseKind Kind, string Name, string? Hint)[] Kinds)[] KindGroups =
    [
        ("Main types", "Every release is one of these.",
        [
            (ReleaseKind.Album, "Albums", null),
            (ReleaseKind.Ep, "EPs", null),
            (ReleaseKind.Single, "Singles", null),
            (ReleaseKind.Broadcast, "Broadcasts", "Radio sessions and the like"),
            (ReleaseKind.Other, "Other", "Anything the catalogue gives no main type"),
        ]),
        ("Kinds of release", "A release can also be any of these.",
        [
            (ReleaseKind.Live, "Live", null),
            (ReleaseKind.Compilation, "Compilations", "Best-ofs, collections, anthologies"),
            (ReleaseKind.Remix, "Remixes", null),
            (ReleaseKind.Demo, "Demos", null),
            (ReleaseKind.Soundtrack, "Soundtracks", null),
            (ReleaseKind.DjMix, "DJ mixes", null),
            (ReleaseKind.Mixtape, "Mixtapes", "And street albums"),
            (ReleaseKind.Spokenword, "Spoken word", null),
            (ReleaseKind.Interview, "Interviews", null),
            (ReleaseKind.Audiobook, "Audiobooks", null),
            (ReleaseKind.AudioDrama, "Audio dramas", null),
            (ReleaseKind.FieldRecording, "Field recordings", null),
        ]),
        ("Unofficial", "Releases that never came out officially.",
        [
            (ReleaseKind.Bootleg, "Bootlegs", "Releases with no official edition at all"),
        ]),
    ];

    private bool IsDefaultShowing => Enum.GetValues<ReleaseKind>().All(k => _settings!.ShowingOf(k) == ReleaseKinds.Default(k));

    // Every kind is written out, so what was read from older settings is kept as it shows.
    private void SetShowing(ReleaseKind kind, ReleaseShowing showing) =>
        _settings = _settings! with { Showing = Enum.GetValues<ReleaseKind>().ToDictionary(k => k, k => k == kind ? showing : _settings.ShowingOf(k)) };

    private void ResetShowing() =>
        _settings = _settings! with { Showing = Enum.GetValues<ReleaseKind>().ToDictionary(k => k, ReleaseKinds.Default) };

    private async Task SaveAsync()
    {
        _saved = false;
        _saveError = null;
        try
        {
            await Api.SaveLibrarySettingsAsync(_settings!);
            await Api.SaveFetchSettingsAsync(_fetch! with { PathTemplate = _fetchTemplate });
            await Api.SaveLogSettingsAsync(_log!);
            _saved = true;
        }
        catch (MelodexApiException e)
        {
            _saveError = e.Message;
        }
    }
}
