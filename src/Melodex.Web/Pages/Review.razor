@page "/review"
@implements IDisposable
@inject MelodexClient Api
@inject RequestTracker Tracker
@inject AuthState Auth
@inject NavigationManager Nav
@inject Preferences Preferences

<PageTitle>Review · Melodex</PageTitle>

<h1>Review</h1>
<p class="muted">
    Files that couldn't be matched confidently. They don't count as owned until they're matched. <strong>Exclude</strong> music
    no catalogue knows, such as your own recordings: it's never matched, and the library shows it as its tags say.
    <strong>Defer</strong> takes a file off this list; each scan tries it again and matches it only when it's confident.
    <strong>Hide</strong> takes it out of the library altogether. Every file stays in your music folder.
</p>
@if (!Auth.May(UserPermissions.Review))
{
    <div class="empty card">You can't review files: that needs the Review and match permission, which the admin can give you.</div>
}

@if (Stuck.Any())
{
    <h2>Requests</h2>
    <p class="muted small">No plugin found a copy that passed the checks. Retry later, add another plugin, or pick a candidate on the Activity page.</p>
    <div class="card">
        <table class="table">
            <tbody>
                @foreach (var request in Stuck)
                {
                    <tr>
                        <td>
                            <div>@request.Title</div>
                            <div class="muted small">@request.Detail</div>
                        </td>
                        <td class="num"><span class="badge @Format.RequestBadge(request)">@Format.RequestLabel(request)</span></td>
                        <td class="num actions">
                            <a class="small" href="activity?open=@request.Id">Details</a>
                            @if (Auth.May(UserPermissions.Request)) { <button class="link small" @onclick="() => RetryAsync(request)">Retry</button> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* Requests show here only when one is stuck, and then the files need a heading of their own. *@
@if (Stuck.Any())
{
    <h2>Files</h2>
}

@if (!Auth.May(UserPermissions.Review))
{
}
else if (_items is null)
{
    <Loading />
}
else if (_items.Count == 0)
{
    <div class="empty card">No files to review.</div>
}
else
{
    var approvable = Visible.Count(i => i.Suggestion is not null);
    var some = _filter.Length > 0;
    @* One line where there's room: the filter box gives way first, to a button that opens it below, then the buttons
       lose their names. *@
    <div class="library-bar review-bar">
        <div class="toolbar one-line">
            <input class="filter" type="search" placeholder="@FilterHint" aria-label="@FilterHint" @bind="_filter" @bind:event="oninput" />
            <button class="icon-button filter-toggle @(_filterOpen || some ? "on" : "")" type="button" title="@FilterHint" aria-label="@FilterHint"
                    aria-expanded="@(_filterOpen ? "true" : "false")" @onclick="ToggleFilter">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6" /><path d="M20 20l-4.5-4.5" /></svg>
            </button>
            <SortMenu Options="Sorts" Value="@_sort" Descending="_descending" DirectionHint="@DirectionHint"
                      OnChange="SortAsync" OnReverse="ReverseAsync" />
            <span class="spacer"></span>
            @* The buttons for every file carry their names where there's room, which teaches the icons each file has below. *@
            <IconButton Icon="approve" Primary="true" Label="@(some ? "Approve these" : "Approve all")" Disabled="@(_busy || approvable == 0)"
                        Title="@(some ? "Accept the suggestion for every file the filter shows" : "Accept the suggestion for every file that has one")"
                        OnClick="@(() => _confirm = "approve")" />
            @foreach (var (aside, verb, icon) in Asides)
            {
                <IconButton Icon="@icon" Label="@($"{verb} {(some ? "these" : "all")}")" Disabled="@(_busy || !Visible.Any())"
                            Title="@($"{verb} every file {(some ? "the filter shows" : "waiting for review")}. {AsideHint(aside)}")"
                            OnClick="() => _confirm = aside.ToString()" />
            }
        </div>
        @if (_filterOpen)
        {
            <div class="filter-drop">
                <input type="search" placeholder="@FilterHint" aria-label="@FilterHint" @ref="_filterDrop" @bind="_filter" @bind:event="oninput" />
            </div>
        }
    </div>
    @if (_confirm == "approve")
    {
        var unsure = Visible.Count(i => i.Suggestion is not null && i.Confidence < 0.6);
        var without = Visible.Count() - approvable;
        <Dialog Title="@($"Approve {Format.Count(approvable, "file", "files")}?")" OnClose="() => _confirm = null" Alert="true">
            <p>Each is matched to the song suggested for it, and counts as owned.</p>
            @if (without > 0)
            {
                <p class="muted">@Format.Count(without, "file has", "files have") no suggestion, so @(without == 1 ? "it stays" : "they stay") here.</p>
            }
            @if (unsure > 0)
            {
                <p class="plugin-message">@Format.Count(unsure, "suggestion is", "suggestions are") less than 60% sure. Filter to check them first if you'd rather.</p>
            }
            <div class="toolbar dialog-buttons">
                <button @onclick="() => _confirm = null">Cancel</button>
                <button class="primary" disabled="@_busy" @onclick="ApproveShownAsync">@if (_busy) { <span class="spinner"></span> }Approve</button>
            </div>
        </Dialog>
    }
    else if (_confirm is not null && Enum.TryParse<SetAside>(_confirm, out var bulk))
    {
        var verb = Asides.First(a => a.As == bulk).Verb;
        <Dialog Title="@($"{verb} {Format.Count(Visible.Count(), "file", "files")}?")" OnClose="() => _confirm = null" Alert="true">
            <p>@AsideHint(bulk) You can put any of them back from the lists below.</p>
            <div class="toolbar dialog-buttons">
                <button @onclick="() => _confirm = null">Cancel</button>
                <button class="danger" disabled="@_busy" @onclick="() => SetShownAsideAsync(bulk)">@if (_busy) { <span class="spinner"></span> }@verb</button>
            </div>
        </Dialog>
    }
    @if (!Visible.Any())
    {
        <div class="empty card">No files match that filter.</div>
    }
    @foreach (var item in Visible)
    {
        <div class="card review-item">
            <div>
                <div class="label">File</div>
                <div class="suggestion-row">
                    <Cover Url="@item.CoverUrl" />
                    <div class="suggestion-text">
                        <div>@(item.Title ?? "(no title)") <span class="muted">· @(item.Artist ?? "unknown artist")</span></div>
                        <div class="muted small path">
                            @item.Path · @Format.Duration(item.DurationSeconds)
                            @if (item.ModifiedAt is { } modified) { <span title="When the file last changed"> · @Changed(modified)</span> }
                        </div>
                        @if (item.Reason is not null) { <div class="muted small">@item.Reason</div> }
                    </div>
                </div>
            </div>
            <div>
                <div class="label">Suggestion</div>
                @if (item.Suggestion is { } s)
                {
                    <div class="suggestion-row">
                        @if (s.AlbumId is { } coverAlbum) { <a href="albums/@coverAlbum" tabindex="-1"><Cover Url="@s.CoverUrl" /></a> }
                        else { <Cover Url="@s.CoverUrl" /> }
                        <div class="suggestion-text">
                            <div class="suggestion">
                                <span class="suggestion-title" title="@s.Title">@s.Title</span>
                                @if (item.Confidence is { } confidence)
                                {
                                    <span class="confidence @ConfidenceClass(confidence)" title="How sure the match is">@confidence.ToString("P0")</span>
                                }
                            </div>
                            <div class="muted small">
                                @if (s.ArtistId is { } artistId) { <a href="artists/@artistId">@s.ArtistCredit</a> } else { @s.ArtistCredit }
                                @if (s.AlbumId is { } albumId) { <span> · <a href="albums/@albumId">@s.AlbumTitle</a></span> }
                                @if (s.DurationSeconds is not null) { <span> · @Format.Duration(s.DurationSeconds)</span> }
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="muted">None found</div>
                }
            </div>
            <div class="review-actions">
                @if (item.Suggestion is { } suggestion)
                {
                    <IconButton Icon="approve" Primary="true" Title="Approve: match it to the suggestion" Disabled="_busy" OnClick="() => ApproveAsync(item, suggestion)" />
                }
                <IconButton Icon="search" Title="Search for what it is" OnClick="() => Nav.NavigateTo(SearchLink(item))" />
                @foreach (var (aside, verb, icon) in Asides)
                {
                    <IconButton Icon="@icon" Title="@($"{verb}. {AsideHint(aside)}")" Disabled="_busy" OnClick="() => SetAsideAsync(item, aside)" />
                }
            </div>
        </div>
    }
}

@foreach (var (list, title, hint) in Lists)
{
    if (_lists.GetValueOrDefault(list) is not { Count: > 0 } files)
        continue;
    var open = _open.Contains(list);
    <h2 class="section">
        <button class="section-toggle" aria-expanded="@(open ? "true" : "false")" @onclick="() => { if (!_open.Remove(list)) _open.Add(list); }">
            <span class="chevron @(open ? "open" : "")" aria-hidden="true"></span>
            @title <span class="muted small">(@files.Count)</span>
        </button>
    </h2>
    @if (open)
    {
        <p class="muted small">@hint</p>
        <div class="card">
            <table class="table">
                <tbody>
                    @foreach (var item in files)
                    {
                        <tr>
                            <td>
                                <div>@(item.Title ?? "(no title)") <span class="muted">· @(item.Artist ?? "unknown artist")</span></div>
                                <div class="muted small path">@item.Path</div>
                            </td>
                            <td class="num actions">
                                <IconButton Icon="search" Class="small" Title="Search for what it is" OnClick="() => Nav.NavigateTo(SearchLink(item))" />
                                <IconButton Icon="putback" Class="small" Title="Put back: on the review list again, and matched again at the next scan" Disabled="_busy"
                                            OnClick="() => SetAsideAsync(item, SetAside.None)" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private IReadOnlyList<ReviewItem>? _items;
    private Dictionary<ReviewList, IReadOnlyList<ReviewItem>> _lists = [];
    private readonly HashSet<ReviewList> _open = [];

    private static readonly (SetAside As, string Verb, string Icon)[] Asides =
        [(SetAside.Excluded, "Exclude", "exclude"), (SetAside.Deferred, "Defer", "defer"), (SetAside.Hidden, "Hide", "hide")];

    private static readonly (ReviewList List, string Title, string Hint)[] Lists =
    [
        (ReviewList.Incomplete, "Incomplete metadata", "Excluded files without a title or artist, so the library can't show them. Fix their tags, or search for what they are."),
        (ReviewList.Excluded, "Excluded files", "Never matched; the library shows them as their tags say."),
        (ReviewList.Deferred, "Deferred files", "Each scan tries these again, and matches one only when it's confident."),
        (ReviewList.Hidden, "Hidden files", "Out of the library altogether, though they stay in your music folder."),
    ];

    private static string AsideHint(SetAside aside) => aside switch
    {
        SetAside.Excluded => "Never match it: no catalogue knows it. The library shows it as its tags say.",
        SetAside.Deferred => "Take it off this list. Each scan tries again, matching it only when it's confident.",
        _ => "Take it out of the library altogether. It stays in your music folder.",
    };
    private string _filter = "";
    private bool _busy;
    private bool _filterOpen, _focusFilter;
    private ElementReference _filterDrop;

    private const string FilterHint = "Filter, for example a title, artist or folder";

    private static readonly IReadOnlyList<(string Key, string Label)> Sorts =
        [("match", "How sure the match is"), ("name", "Name"), ("path", "Path"), ("date", "Date changed")];

    // How each sort starts out: the surest matches and the newest files first, names and paths from A.
    private static bool StartsDescending(string sort) => sort is "match" or "date";

    private string _sort = "path";
    private bool _descending;

    private string DirectionHint => _sort switch
    {
        "match" => $"{(_descending ? "Surest" : "Least sure")} first; click to reverse",
        "date" => $"{(_descending ? "Newest" : "Oldest")} first; click to reverse",
        _ => $"Sorted {(_descending ? "Z to A" : "A to Z")}; click to reverse",
    };

    // The bulk action waiting to be confirmed: approve or exclude.
    private string? _confirm;

    private IEnumerable<ReviewItem> Visible => Sorted(_items!.Where(i => _filter.Length == 0
        || new[] { i.Path, i.Title, i.Artist, i.Album, i.Suggestion?.Title, i.Suggestion?.AlbumTitle }
            .Any(text => text?.Contains(_filter, StringComparison.OrdinalIgnoreCase) == true)));

    // Files without a match % go last either way; the path settles ties.
    private IEnumerable<ReviewItem> Sorted(IEnumerable<ReviewItem> items)
    {
        var text = StringComparer.CurrentCultureIgnoreCase;
        var sorted = (_sort, _descending) switch
        {
            ("match", true) => items.OrderBy(i => i.Confidence is null).ThenByDescending(i => i.Confidence),
            ("match", false) => items.OrderBy(i => i.Confidence is null).ThenBy(i => i.Confidence),
            ("date", true) => items.OrderByDescending(i => i.ModifiedAt),
            ("date", false) => items.OrderBy(i => i.ModifiedAt),
            ("name", true) => items.OrderByDescending(NameOf, text),
            ("name", false) => items.OrderBy(NameOf, text),
            (_, true) => items.OrderByDescending(i => i.Path, text),
            _ => items.OrderBy(i => i.Path, text),
        };
        return sorted.ThenBy(i => i.Path, StringComparer.Ordinal);
    }

    private static string NameOf(ReviewItem item) => item.Title ?? Path.GetFileNameWithoutExtension(item.Path);

    private static string Changed(DateTime modified) =>
        DateTime.SpecifyKind(modified, DateTimeKind.Utc).ToLocalTime().ToString("d MMM yyyy");

    private async Task SortAsync(string sort)
    {
        _sort = sort;
        _descending = StartsDescending(sort);
        await KeepSortAsync();
    }

    private async Task ReverseAsync()
    {
        _descending = !_descending;
        await KeepSortAsync();
    }

    private async Task KeepSortAsync()
    {
        await Preferences.SetAsync("review.sort", _sort);
        await Preferences.SetAsync("review.descending", _descending);
    }

    private void ToggleFilter()
    {
        _filterOpen = !_filterOpen;
        _focusFilter = _filterOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusFilter)
        {
            _focusFilter = false;
            await _filterDrop.FocusAsync();
        }
    }

    // Requests that stopped short, or have parts that did.
    private IEnumerable<RequestInfo> Stuck => Tracker.Requests.Where(r =>
        r.State is RequestState.NeedsReview or RequestState.Failed
        || !r.Active && r.State != RequestState.Cancelled && r.Parts is { } p && p.NeedsReview + p.Failed > 0);

    protected override async Task OnInitializedAsync()
    {
        Tracker.Changed += Refresh;
        _sort = await Preferences.GetAsync("review.sort", "path");
        if (Sorts.All(s => s.Key != _sort))
            _sort = "path";
        _descending = await Preferences.GetAsync("review.descending", StartsDescending(_sort));
        await Tracker.EnsureLoadedAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!Auth.May(UserPermissions.Review))
        {
            _items = [];
            _lists = Lists.ToDictionary(l => l.List, _ => (IReadOnlyList<ReviewItem>)[]);
            return;
        }
        var items = Api.GetReviewAsync();
        var lists = Lists.Select(l => (l.List, Task: Api.GetReviewAsync(l.List))).ToList();
        _items = await items;
        var loaded = new Dictionary<ReviewList, IReadOnlyList<ReviewItem>>();
        foreach (var (list, task) in lists)
            loaded[list] = await task;
        _lists = loaded;
    }

    private async Task SetAsideAsync(ReviewItem item, SetAside aside)
    {
        _busy = true;
        await Api.SetFileAsideAsync(item.FileId, aside);
        await LoadAsync();
        _busy = false;
        ScanStatus.RaiseLibraryChanged();
    }

    private Task SetShownAsideAsync(SetAside aside) => BulkAsync(() => Api.SetFilesAsideAsync(Visible.Select(i => i.FileId).ToList(), aside));

    private Task ApproveShownAsync() => BulkAsync(() => Api.ApproveFilesAsync(Visible.Where(i => i.Suggestion is not null).Select(i => i.FileId).ToList()));

    private async Task BulkAsync(Func<Task> action)
    {
        _busy = true;
        try
        {
            await action();
            _filter = "";
            await LoadAsync();
            ScanStatus.RaiseLibraryChanged();
        }
        finally
        {
            _busy = false;
            _confirm = null;
        }
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private static string ConfidenceClass(double confidence) => confidence >= 0.8 ? "high" : confidence >= 0.6 ? "medium" : "low";

    private static string SearchLink(ReviewItem item)
    {
        var words = string.Join(' ', new[] { item.Artist, item.Title ?? Path.GetFileNameWithoutExtension(item.Path) }.Where(w => !string.IsNullOrWhiteSpace(w)));
        return $"search?q={Uri.EscapeDataString(words)}&file={item.FileId}";
    }

    private async Task ApproveAsync(ReviewItem item, SuggestedTrack suggestion)
    {
        _busy = true;
        await Api.MatchFileAsync(item.FileId, new MatchFile(suggestion.TrackId, suggestion.EditionId));
        _items = await Api.GetReviewAsync();
        _busy = false;
        ScanStatus.RaiseLibraryChanged();
    }

    private async Task RetryAsync(RequestInfo request)
    {
        await Api.RetryRequestAsync(request.Id);
        await Tracker.RefreshAsync();
    }

    public void Dispose() => Tracker.Changed -= Refresh;
}
