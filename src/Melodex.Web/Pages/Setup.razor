@page "/setup"
@using Melodex.Contracts.Plugins
@inject MelodexClient Api
@inject AuthState Auth
@inject NavigationManager Nav

<PageTitle>Setup · Melodex</PageTitle>

@*
    The steps after making the admin account: check the music folder, connect Navidrome, choose where music comes
    from, and scan. Each can be skipped; everything here is in Settings later too.
*@
<h1>Welcome to Melodex</h1>
<p class="muted">A few things to set up. Skip any of them: they're all under Settings later.</p>

@if (!Auth.May(UserPermissions.Settings))
{
    <div class="empty card">Setting up Melodex needs the Settings and plugins permission. <a href="">Go to the library</a></div>
}
else if (_status is null)
{
    <Loading />
}
else
{
    <ol class="setup-steps">
        <li class="setup-step @(_step == 0 ? "open" : "")">
            <button class="setup-head" @onclick="() => _step = 0">
                <span class="setup-number">1</span>
                <strong>Your music folder</strong>
                @StepBadge(_status.LibraryReadable && _status.AudioFiles > 0)
            </button>
            @if (_step == 0)
            {
                <div class="setup-body">
                    <p>Melodex reads <code>@_status.LibraryPath</code>, the folder Navidrome reads too.</p>
                    @if (!_status.LibraryReadable)
                    {
                        <p class="error">Melodex can't open it. Check <code>MUSIC_PATH</code> in your compose file, and that the folder can be read by the container.</p>
                    }
                    else if (_status.AudioFiles == 0)
                    {
                        <p class="error">It's empty, or holds no music Melodex knows. Check <code>MUSIC_PATH</code> points at your music.</p>
                    }
                    else
                    {
                        <p>It has @(_status.AudioFiles >= SetupStatus.CountLimit ? $"over {SetupStatus.CountLimit:N0}" : _status.AudioFiles.ToString("N0")) music files.</p>
                    }
                    <div class="toolbar">
                        <button @onclick="CheckAsync" disabled="@_busy">Check again</button>
                        <button class="primary" @onclick="() => _step = 1">Next</button>
                    </div>
                </div>
            }
        </li>

        <li class="setup-step @(_step == 1 ? "open" : "")">
            <button class="setup-head" @onclick="() => _step = 1">
                <span class="setup-number">2</span>
                <strong>Navidrome</strong>
                @StepBadge(_status.MediaServer)
            </button>
            @if (_step == 1)
            {
                <div class="setup-body">
                    <p>Melodex tells Navidrome to scan when music arrives, and shows covers from your own files through it.</p>
                    @if (_status.MediaServer)
                    {
                        <p>Navidrome is connected. Change it under <a href="settings/plugins">Settings → Plugins</a>.</p>
                    }
                    else if (_navidrome is { } navidrome)
                    {
                        <SchemaForm @ref="_form" Schema="navidrome.Manifest.SettingsSchema" />
                    }
                    @if (_error is not null) { <p class="error">@_error</p> }
                    <div class="toolbar">
                        <button @onclick="() => _step = 2">@(_status.MediaServer ? "Next" : "Skip")</button>
                        @if (!_status.MediaServer && _navidrome is not null)
                        {
                            <button class="primary" disabled="@_busy" @onclick="ConnectAsync">
                                @if (_busy) { <span class="spinner"></span> }Connect
                            </button>
                        }
                    </div>
                </div>
            }
        </li>

        <li class="setup-step @(_step == 2 ? "open" : "")">
            <button class="setup-head" @onclick="() => _step = 2">
                <span class="setup-number">3</span>
                <strong>Where music comes from</strong>
                @StepBadge(_status.Retrieval)
            </button>
            @if (_step == 2)
            {
                <div class="setup-body">
                    <p>Retrieval plugins fetch what you ask for. The compose file runs these two; choose the ones to use. Without one you can still browse and see what's missing.</p>
                    @foreach (var source in Plugins.KnownSources.Where(s => !string.IsNullOrEmpty(s.Endpoint)))
                    {
                        var added = _plugins.Any(p => p.Endpoint == source.Endpoint);
                        <label class="dialog-choice @(added ? "dim" : "")">
                            <input type="checkbox" disabled="@added" checked="@(added || _sources.Contains(source.Key))"
                                   @onchange="e => Toggle(source.Key, (bool)e.Value!)" />
                            <span><strong>@source.Name</strong><span class="muted small">@(added ? "Added. " : "")@source.Description</span></span>
                        </label>
                    }
                    <p class="muted small">You're responsible for the plugins you run, and for keeping to each source's terms.</p>
                    @if (_error is not null) { <p class="error">@_error</p> }
                    <div class="toolbar">
                        <button @onclick="() => _step = 3">@(_sources.Count == 0 ? "Skip" : "Not now")</button>
                        @if (_sources.Count > 0)
                        {
                            <button class="primary" disabled="@_busy" @onclick="AddSourcesAsync">
                                @if (_busy) { <span class="spinner"></span> }Add and test
                            </button>
                        }
                    </div>
                </div>
            }
        </li>

        <li class="setup-step @(_step == 3 ? "open" : "")">
            <button class="setup-head" @onclick="() => _step = 3">
                <span class="setup-number">4</span>
                <strong>The first scan</strong>
                @StepBadge(_status.Scanned || _scanning)
            </button>
            @if (_step == 3)
            {
                <div class="setup-body">
                    <p>
                        Melodex reads every file and matches it against MusicBrainz, then fills in each artist's albums. Matching is quick; the
                        albums take about a second each, as MusicBrainz asks, so a big library takes a while. Pages fill in as it goes.
                    </p>
                    @if (_error is not null) { <p class="error">@_error</p> }
                    <div class="toolbar">
                        @if (_scanning || _status.Scanned)
                        {
                            <span class="muted">@(_scanning ? "Scanning. Follow it on Activity." : "Scanned.")</span>
                        }
                        else
                        {
                            <button class="primary" disabled="@_busy" @onclick="ScanAsync">Scan now</button>
                        }
                    </div>
                </div>
            }
        </li>
    </ol>

    <div class="toolbar">
        <span class="spacer"></span>
        <button class="primary" disabled="@_busy" @onclick="FinishAsync">Go to the library</button>
    </div>
}

@code {
    private SetupStatus? _status;
    private IReadOnlyList<PluginInfo> _plugins = [];
    private AvailablePlugin? _navidrome;
    private SchemaForm? _form;
    private readonly HashSet<string> _sources = [];
    private int _step;
    private bool _busy;
    private bool _scanning;
    private string? _error;

    private const string NavidromeId = "melodex.connector.navidrome";

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.May(UserPermissions.Settings))
            return;
        _navidrome = (await Api.ListAvailablePluginsAsync()).FirstOrDefault(p => p.Manifest.Id == NavidromeId && p.Problem is null);
        await CheckAsync();
        // Start at the first step that wants something.
        _step = !_status!.LibraryReadable || _status.AudioFiles == 0 ? 0 : !_status.MediaServer ? 1 : !_status.Retrieval ? 2 : 3;
        foreach (var source in Plugins.KnownSources.Where(s => !string.IsNullOrEmpty(s.Endpoint)))
            _sources.Add(source.Key);
    }

    private async Task CheckAsync()
    {
        _busy = true;
        try
        {
            _status = await Api.GetSetupAsync();
            _plugins = await Api.ListPluginsAsync();
            _sources.RemoveWhere(key => _plugins.Any(p => p.Endpoint == Plugins.KnownSources.First(s => s.Key == key).Endpoint));
        }
        finally
        {
            _busy = false;
        }
    }

    private RenderFragment StepBadge(bool done) => done
        ? @<span class="badge owned">Done</span>
        : @<span class="badge neutral">To do</span>;

    private void Toggle(string key, bool on)
    {
        if (on)
            _sources.Add(key);
        else
            _sources.Remove(key);
    }

    private Task ConnectAsync() => RunAsync(async () =>
    {
        var added = await Api.AddPluginAsync(new AddPlugin(PluginId: NavidromeId, Settings: _form!.ToJson()));
        var tested = await Api.TestPluginAsync(added.Id);
        if (tested.Health == HealthStatus.Unhealthy)
        {
            // Keep what was typed, to fix and try again.
            await Api.RemovePluginAsync(added.Id);
            throw new MelodexApiException(System.Net.HttpStatusCode.BadRequest, $"Couldn't reach Navidrome: {tested.HealthMessage}");
        }
        _step = 2;
    });

    private Task AddSourcesAsync() => RunAsync(async () =>
    {
        foreach (var source in Plugins.KnownSources.Where(s => _sources.Contains(s.Key)))
        {
            var added = await Api.AddPluginAsync(new AddPlugin(Endpoint: source.Endpoint));
            await Api.TestPluginAsync(added.Id);
        }
        _step = 3;
    });

    private Task ScanAsync() => RunAsync(async () =>
    {
        await Api.ScanLibraryAsync();
        _scanning = true;
    });

    private async Task FinishAsync()
    {
        await RunAsync(() => Api.FinishSetupAsync());
        if (_error is null)
            Nav.NavigateTo("");
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
            await CheckAsync();
        }
        catch (MelodexApiException e)
        {
            _error = e.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
