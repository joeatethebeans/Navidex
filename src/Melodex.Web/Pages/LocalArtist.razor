@page "/local/artists/{Id:guid}"
@implements IDisposable
@inject MelodexClient Api

<PageTitle>@(_artist?.Name ?? "Artist") · Melodex</PageTitle>

@* An artist only your own files name: no catalogue knows them, so their albums are as the files' tags say. *@
@if (_notFound)
{
    <div class="empty card">That artist isn't in your library. Their files may have been matched, changed or put back for review.</div>
}
else if (_artist is null)
{
    <Loading />
}
else
{
    <div class="page-head">
        <Cover Url="@_artist.ImageUrl" Artist="true" />
        <div>
            <h1>@_artist.Name</h1>
            <div class="row muted small">
                <span>@Format.Count(_artist.Albums.Count, "album", "albums")</span>
                <span class="badge neutral" title="No catalogue knows them: they're shown as their files' tags say">Your own files</span>
            </div>
        </div>
    </div>
    <AlbumTable Albums="_artist.Albums" />
}

@code {
    [Parameter] public Guid Id { get; set; }

    private LocalArtistDetail? _artist;
    private bool _notFound;

    protected override async Task OnParametersSetAsync()
    {
        ScanStatus.LibraryChanged -= Reload;
        ScanStatus.LibraryChanged += Reload;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _artist = await Api.GetLocalArtistAsync(Id);
        _notFound = _artist is null;
    }

    private void Reload() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => ScanStatus.LibraryChanged -= Reload;
}
