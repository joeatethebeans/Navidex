@page "/playlists"
@implements IDisposable
@inject MelodexClient Api
@inject AuthState Auth
@inject Player Player
@inject Preferences Preferences

<PageTitle>Playlists · Melodex</PageTitle>

@* Your playlists, pinned ones first, in their folders or as squares, and whether they're synced with the media server. *@
<h1>Library</h1>
<LibraryTabs Current="playlists" />

<div class="toolbar one-line playlists-bar">
    <Segmented T="string" Value="_view" Options="Views" OnChange="ViewAsync" Label="Show as" />
    <input class="filter" type="search" placeholder="Find a playlist" aria-label="Find a playlist" @bind="_filter" @bind:event="oninput" />
    <SortMenu Options="Sorts" Value="@_sort" Descending="_descending" DirectionHint="Reverse the order"
              OnChange="key => SortAsync(key, null)" OnReverse="() => SortAsync(_sort, !_descending)" />
    <IconButton Icon="pin" On="_showPinned" Title="@(_showPinned ? "Hide the pinned row" : "Show your pinned playlists in a row at the top")" OnClick="TogglePinnedAsync" />
    <span class="spacer"></span>
    @if (_sync is { Available: true, Linked: true })
    {
        <span class="muted small hide-narrow" title="@(_sync.Error ?? "")">
            @if (_sync.Error is not null) { <span class="error">Not synced: @_sync.Error</span> }
            else if (_sync.SyncedAt is { } at) { <text>Synced with @_sync.Server @Format.Ago(at)</text> }
            else { <text>Syncing with @_sync.Server…</text> }
        </span>
        <IconButton Icon="retry" Title="@($"Sync with {_sync.Server} now")" OnClick="SyncAsync" />
    }
    <IconButton Icon="plus" Primary="true" Label="New playlist" Title="Make a playlist" OnClick="() => StartNew(null)" />
</div>

@if (_sync is { Available: true, Linked: false })
{
    <p class="muted small">
        Link your @_sync.Server login on <a href="account">your account</a> to have your playlists there too, and theirs here.
    </p>
}

@if (_error is not null)
{
    <div class="empty card error">@_error</div>
}
else if (_playlists is null)
{
    <Loading />
}
else if (_playlists.Count == 0)
{
    <div class="empty card">
        No playlists yet. Make one here, or add songs to one from a song's or album's page or the player.
    </div>
}
else
{
    var shown = Shown().ToList();
    var pinned = Sorted(_playlists.Where(p => p.Pinned)).ToList();
    @if (_showPinned && pinned.Count > 0 && _filter.Trim().Length == 0)
    {
        <h2 class="section">Pinned <span class="muted small">@pinned.Count</span></h2>
        <div class="tiles pinned-row">
            @foreach (var playlist in pinned) { @Tile(playlist) }
        </div>
        <h2 class="section">All playlists <span class="muted small">@_playlists.Count</span></h2>
    }
    @if (shown.Count == 0)
    {
        <div class="empty card">No playlists called that.</div>
    }
    else if (_view == "squares")
    {
        <div class="tiles">
            @foreach (var playlist in shown) { @Tile(playlist) }
        </div>
    }
    else if (_filter.Trim().Length > 0)
    {
        @* Found by name: one list, each with its folders. *@
        <div class="card playlist-tree">
            <ul class="playlist-list">
                @foreach (var playlist in shown) { @Row(playlist, withFolders: true) }
            </ul>
        </div>
    }
    else
    {
        <div class="card playlist-tree">
            @Folder(Tree(shown))
        </div>
    }
}

@if (_naming)
{
    <Dialog Title="@(_renamingFolder is null ? "New playlist" : $"Rename the folder {_renamingFolder.Split(Delimiter)[^1]}")" OnClose="() => _naming = false">
        <div class="field">
            <label class="field-label" for="playlist-name">@(_renamingFolder is null ? "Name" : "Folder")</label>
            <input id="playlist-name" type="text" @bind="_name" @bind:event="oninput" @onkeydown="EnterAsync" />
            @if (Delimiter.Length > 0)
            {
                <span class="muted small">
                    @(_renamingFolder is null ? $"Put it in folders with {Delimiter}, as in Moods{Delimiter}Calm." : $"Move it into another folder with {Delimiter}, or leave it empty to take everything out of it.")
                </span>
            }
        </div>
        @if (_nameError is not null) { <p class="error small">@_nameError</p> }
        <div class="toolbar">
            <span class="spacer"></span>
            <button @onclick="() => _naming = false">Cancel</button>
            <button class="primary" disabled="@(_busy || _renamingFolder is null && _name.Trim().Length == 0)" @onclick="SaveNameAsync">
                @(_renamingFolder is null ? "Make it" : "Rename")
            </button>
        </div>
    </Dialog>
}

@code {
    private IReadOnlyList<PlaylistSummary>? _playlists;
    private PlaylistSyncStatus? _sync;
    private string? _error;
    private HashSet<string> _closed = [];
    private bool _naming, _busy;
    private string _name = "";
    private string? _renamingFolder, _nameError;

    // How they're shown, kept in this browser.
    private string _view = "list", _sort = "name", _filter = "";
    private bool _descending, _showPinned = true;

    private static readonly IReadOnlyList<(string, string, string?)> Views =
        [("list", "List", "In their folders"), ("squares", "Squares", "As squares, each with its picture")];

    private static readonly IReadOnlyList<(string Key, string Label)> Sorts =
        [("name", "Name"), ("changed", "Last changed"), ("songs", "Songs"), ("length", "Length")];

    private string Delimiter => PlaylistNames.Delimiter(Auth);

    private sealed record Node(string Path, string Name, List<Node> Folders, List<PlaylistSummary> Playlists)
    {
        public int Count => Playlists.Count + Folders.Sum(f => f.Count);
    }

    protected override async Task OnInitializedAsync()
    {
        ScanStatus.LibraryChanged += Reload;
        _closed = (await Preferences.GetAsync<string[]>("playlists.closed", [])).ToHashSet();
        _view = await Preferences.GetAsync("playlists.view", "list");
        _sort = await Preferences.GetAsync("playlists.sort", "name");
        _descending = await Preferences.GetAsync("playlists.descending", false);
        _showPinned = await Preferences.GetAsync("playlists.pinned", true);
        await LoadAsync();
    }

    private void Reload() => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    public void Dispose() => ScanStatus.LibraryChanged -= Reload;

    private async Task LoadAsync()
    {
        try
        {
            _playlists = await Api.ListPlaylistsAsync();
            _sync = await Api.GetPlaylistSyncAsync();
            _error = null;
        }
        catch (Exception e) when (e is HttpRequestException or MelodexApiException)
        {
            _error = e.Message;
        }
    }

    private async Task SyncAsync()
    {
        _sync = await Api.SyncPlaylistsAsync();
        await LoadAsync();
    }

    private async Task ViewAsync(string view)
    {
        _view = view;
        await Preferences.SetAsync("playlists.view", view);
    }

    private async Task SortAsync(string key, bool? descending)
    {
        // A new order starts the way people expect: names A to Z, the rest biggest or latest first.
        _descending = descending ?? key != "name";
        _sort = key;
        await Preferences.SetAsync("playlists.sort", key);
        await Preferences.SetAsync("playlists.descending", _descending);
    }

    private async Task TogglePinnedAsync()
    {
        _showPinned = !_showPinned;
        await Preferences.SetAsync("playlists.pinned", _showPinned);
    }

    private async Task PinAsync(PlaylistSummary playlist)
    {
        var changed = await Api.PinPlaylistAsync(playlist.Id, !playlist.Pinned);
        _playlists = _playlists!.Select(p => p.Id == changed.Id ? changed : p).ToList();
    }

    // Found by any part of the name, folders too.
    private IEnumerable<PlaylistSummary> Shown() => Sorted(_playlists!.Where(p =>
        _filter.Trim() is var find && (find.Length == 0 || p.Name.Contains(find, StringComparison.CurrentCultureIgnoreCase))));

    private IEnumerable<PlaylistSummary> Sorted(IEnumerable<PlaylistSummary> playlists)
    {
        var byName = StringComparer.CurrentCultureIgnoreCase;
        var sorted = _sort switch
        {
            "changed" => playlists.OrderBy(p => p.UpdatedAt),
            "songs" => playlists.OrderBy(p => p.Count),
            "length" => playlists.OrderBy(p => p.DurationSeconds),
            _ => playlists.OrderBy(p => PlaylistNames.Leaf(p.Name, Delimiter), byName),
        };
        return _descending ? sorted.Reverse() : sorted.ThenBy(p => p.Name, byName);
    }

    // The playlists in folders, each folder before the playlists beside it, in the order chosen within each.
    private Node Tree(IEnumerable<PlaylistSummary> playlists)
    {
        var root = new Node("", "", [], []);
        foreach (var playlist in playlists)
        {
            var node = root;
            foreach (var folder in PlaylistNames.Folders(playlist.Name, Delimiter))
            {
                var path = node.Path.Length == 0 ? folder : node.Path + Delimiter + folder;
                var next = node.Folders.FirstOrDefault(f => f.Path == path);
                if (next is null)
                    node.Folders.Add(next = new Node(path, folder, [], []));
                node = next;
            }
            node.Playlists.Add(playlist);
        }
        return root;
    }

    private RenderFragment Tile(PlaylistSummary playlist) => @<div class="tile-wrap" @key="playlist.Id">
        <a class="tile" href="playlists/@playlist.Id" title="@playlist.Name">
            <PlaylistCover Covers="playlist.Covers" />
            <div class="tile-name">@PlaylistNames.Leaf(playlist.Name, Delimiter)</div>
            <div class="muted small tile-sub">
                @(string.Join(" › ", PlaylistNames.Folders(playlist.Name, Delimiter)) is { Length: > 0 } folders ? $"{folders} · " : "")@PlaylistNames.Length(playlist.Count, playlist.DurationSeconds)
            </div>
        </a>
        <IconButton Icon="pin" Class="@($"small tile-remove tile-pin {(playlist.Pinned ? "pinned" : "")}")" On="playlist.Pinned"
                    Title="@(playlist.Pinned ? "Unpin it" : "Pin it, to show it first")" OnClick="() => PinAsync(playlist)" />
    </div>;

    private RenderFragment Row(PlaylistSummary playlist, bool withFolders) => @<li @key="playlist.Id">
        <div class="playlist-row">
            <a class="plain playlist-link" href="playlists/@playlist.Id">
                <PlaylistCover Covers="playlist.Covers" Class="small" />
                <span class="playlist-text">
                    <span class="ellipsis">@(withFolders && Delimiter.Length > 0 ? playlist.Name.Replace(Delimiter, " › ") : PlaylistNames.Leaf(playlist.Name, Delimiter))</span>
                    <span class="muted small">
                        @PlaylistNames.Length(playlist.Count, playlist.DurationSeconds)
                        @if (playlist.Sync == PlaylistSyncState.Waiting) { <span title="Changed since the last sync, or has songs the media server hasn't found yet"> · waiting to sync</span> }
                    </span>
                </span>
            </a>
            <IconButton Icon="pin" Class="@($"small row-pin {(playlist.Pinned ? "pinned" : "")}")" On="playlist.Pinned"
                        Title="@(playlist.Pinned ? "Unpin it" : "Pin it, to show it first")" OnClick="() => PinAsync(playlist)" />
            <IconButton Icon="play" Requires="@UserPermissions.Listen" Class="small" Title="Play" Disabled="playlist.Count == 0" OnClick="() => PlayAsync(playlist.Id)" />
        </div>
    </li>;

    private RenderFragment Folder(Node node) => @<ul class="playlist-list">
        @foreach (var folder in node.Folders.OrderBy(f => f.Name, StringComparer.CurrentCultureIgnoreCase))
        {
            var open = !_closed.Contains(folder.Path);
            <li class="playlist-folder">
                <div class="playlist-row">
                    <button class="plain folder-toggle" aria-expanded="@(open ? "true" : "false")" @onclick="() => ToggleAsync(folder.Path)">
                        <svg viewBox="0 0 24 24" class="chevron @(open ? "open" : "")" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
                        <svg viewBox="0 0 24 24" class="folder-icon" aria-hidden="true"><path d="M3 6.5A1.5 1.5 0 0 1 4.5 5H9l2 2.5h8.5A1.5 1.5 0 0 1 21 9v9.5a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18.5z" /></svg>
                        <strong>@folder.Name</strong>
                        <span class="muted small">@folder.Count</span>
                    </button>
                    <span class="spacer"></span>
                    <IconButton Icon="plus" Class="small" Title="@($"Make a playlist in {folder.Name}")" OnClick="() => StartNew(folder.Path)" />
                    <IconButton Icon="rename" Class="small" Title="@($"Rename {folder.Name}")" OnClick="() => StartRename(folder.Path)" />
                </div>
                @if (open)
                {
                    @Folder(folder)
                }
            </li>
        }
        @foreach (var playlist in node.Playlists)
        {
            @Row(playlist, withFolders: false)
        }
    </ul>;

    private async Task ToggleAsync(string path)
    {
        if (!_closed.Add(path))
            _closed.Remove(path);
        await Preferences.SetAsync("playlists.closed", _closed.ToArray());
    }

    private async Task PlayAsync(Guid id)
    {
        if (await Api.GetPlaylistAsync(id) is { } playlist)
            await Player.PlayAsync(PlaylistNames.Playable(playlist.Songs));
    }

    private void StartNew(string? folder)
    {
        _renamingFolder = null;
        _name = folder is null ? "" : folder + Delimiter;
        _nameError = null;
        _naming = true;
    }

    private void StartRename(string folder)
    {
        _renamingFolder = folder;
        _name = folder;
        _nameError = null;
        _naming = true;
    }

    private Task EnterAsync(KeyboardEventArgs e) => e.Key == "Enter" ? SaveNameAsync() : Task.CompletedTask;

    private async Task SaveNameAsync()
    {
        _busy = true;
        _nameError = null;
        try
        {
            if (_renamingFolder is { } folder)
            {
                await Api.RenamePlaylistFolderAsync(new RenamePlaylistFolder(folder, _name.Trim(), Delimiter));
                if (_closed.Remove(folder))
                    _closed.Add(_name.Trim());
            }
            else
            {
                var made = await Api.CreatePlaylistAsync(new CreatePlaylist(_name.Trim()));
                foreach (var parent in PlaylistNames.Folders(made.Playlist.Name, Delimiter))
                    _closed.RemoveWhere(c => c.EndsWith(parent, StringComparison.Ordinal));
            }
            _naming = false;
            await LoadAsync();
        }
        catch (Exception e) when (e is HttpRequestException or MelodexApiException)
        {
            _nameError = e.Message;
        }
        _busy = false;
    }
}
