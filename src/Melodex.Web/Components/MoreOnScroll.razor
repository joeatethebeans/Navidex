@implements IAsyncDisposable
@using Microsoft.JSInterop
@inject IJSRuntime Js

@*
    Put straight after a long list drawn a page at a time: asks for more as it nears the screen. It takes up the room the
    rest of the list will, so the scrollbar is the size of the whole list from the start.
*@
<div class="more-on-scroll" @ref="_element" data-remaining="@Remaining" aria-hidden="true"></div>

@code {
    /// <summary>Draws the next page.</summary>
    [Parameter, EditorRequired] public EventCallback OnMore { get; set; }

    /// <summary>How many items are still to be drawn.</summary>
    [Parameter] public int Remaining { get; set; }

    private ElementReference _element;
    private DotNetObjectReference<MoreOnScroll>? _self;
    private IJSObjectReference? _module;
    private IJSObjectReference? _observer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            if (_observer is not null)
                await _observer.InvokeVoidAsync("size");
            return;
        }
        _self = DotNetObjectReference.Create(this);
        _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/more.js");
        _observer = await _module.InvokeAsync<IJSObjectReference>("observe", _element, _self);
    }

    [JSInvokable]
    public Task MoreAsync() => OnMore.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_observer is not null)
            {
                await _observer.InvokeVoidAsync("dispose");
                await _observer.DisposeAsync();
            }
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        _self?.Dispose();
    }
}
