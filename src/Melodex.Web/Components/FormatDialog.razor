@inject MelodexClient Api

@*
    Formats an artist, album, track or the whole library: rewrites matched files' tags from the catalogue, their embedded
    cover from an artwork plugin, and if asked, where they live. Each part can come from a different source, or stay as
    the file has it. Says plainly that it writes the music files before starting.
*@
<Dialog Title="@($"Format {_plan?.Title ?? Name}")" Class="format-dialog" OnClose="CloseAsync">
    @if (_started is { } task)
    {
        <p>Formatting has started. It runs in the background; you can follow it, pause it or cancel it on <a href="activity">Activity</a>.</p>
        <div class="toolbar dialog-buttons"><button class="primary" @onclick="CloseAsync">Close</button></div>
    }
    else if (_plan is null)
    {
        @if (_error is not null) { <p class="error">@_error</p> } else { <Loading Inline="true" /> }
    }
    else if (_plan.Formattable == 0)
    {
        <p>
            @(_plan.Files == 0 ? "There are no files of it in the library" : $"None of its {Format.Count(_plan.Files, "file", "files")} is matched to the catalogue"),
            so there's nothing to format.
        </p>
        <div class="toolbar dialog-buttons"><button @onclick="CloseAsync">Close</button></div>
    }
    else
    {
        <p class="notice warning">
            This rewrites @Format.Count(_plan.Formattable, "file", "files") in your music folder@(Writes). It can't be undone.
            @if (Scope.Kind == FormatScopeKind.Library) { <span>Over the whole library this can take a while. It runs in the background, and you can pause it on Activity.</span> }
        </p>
        @if (_plan.Files > _plan.Formattable)
        {
            <p class="muted small">@Format.Count(_plan.Files - _plan.Formattable, "file isn't", "files aren't") matched to the catalogue, so @(_plan.Files - _plan.Formattable == 1 ? "it's" : "they're") left as @(_plan.Files - _plan.Formattable == 1 ? "it is" : "they are").</p>
        }

        <div class="format-choices">
            @foreach (var part in Parts)
            {
                <label>
                    <span>
                        @part.Name
                        <span class="muted small">@part.Hint</span>
                    </span>
                    <select value="@part.Get()" @onchange="e => part.Set(e.Value?.ToString() ?? FormatSources.Keep)">
                        @foreach (var source in part.Artwork ? _plan.Artwork : _plan.Tags)
                        {
                            <option value="@source.Id">@source.Name</option>
                        }
                    </select>
                </label>
            }
        </div>

        <label class="dialog-choice">
            <input type="checkbox" checked="@_options.Move" @onchange="e => _options = _options with { Move = (bool)e.Value! }" />
            <span>
                <strong>Move and rename the files</strong>
                <span class="muted small">To where an import would put them now, going by their new tags: <code>@_plan.PathTemplate</code>. The layout is set in <a href="settings">Settings</a>.</span>
            </span>
        </label>

        @if (!_plan.WorkerReady)
        {
            <p class="error small">Can't format now: @(_plan.WorkerProblem?.TrimEnd('.') ?? "the beets worker, which writes the music folder, isn't working").</p>
        }
        else if (Nothing)
        {
            <p class="muted small">Everything is set to stay as it is, so there's nothing to do.</p>
        }
        @if (_error is not null) { <p class="error small">@_error</p> }
        <div class="toolbar dialog-buttons">
            <button @onclick="CloseAsync" disabled="@_busy">Cancel</button>
            <button class="danger" @onclick="StartAsync" disabled="@(_busy || !_plan.WorkerReady || Nothing)">
                @if (_busy) { <span class="spinner"></span> }
                Format @Format.Count(_plan.Formattable, "file", "files")
            </button>
        </div>
    }
</Dialog>

@code {
    [Parameter, EditorRequired] public FormatScope Scope { get; set; } = null!;

    /// <summary>What's being formatted, until the plan says.</summary>
    [Parameter] public string Name { get; set; } = "";

    [Parameter] public EventCallback OnClose { get; set; }

    private FormatPlan? _plan;
    private FormatOptions _options = new();
    private TaskInfo? _started;
    private bool _busy;
    private string? _error;

    private sealed record Part(string Name, string Hint, Func<string> Get, Action<string> Set, bool Artwork = false);

    private IEnumerable<Part> Parts =>
    [
        new("Titles and artists", "Title, artist, album, album artist", () => _options.Titles, v => _options = _options with { Titles = v }),
        new("Track and disc numbers", "And how many there are", () => _options.Numbers, v => _options = _options with { Numbers = v }),
        new("Release details", "Dates, country, media, album type", () => _options.Release, v => _options = _options with { Release = v }),
        new("Identifiers", "MusicBrainz IDs, ISRC", () => _options.Identifiers, v => _options = _options with { Identifiers = v }),
        new("Cover", "The picture embedded in each file", () => _options.Artwork, v => _options = _options with { Artwork = v }, Artwork: true),
    ];

    private bool Nothing => !_options.Move && _options.Artwork == FormatSources.Keep
                            && new[] { _options.Titles, _options.Numbers, _options.Release, _options.Identifiers }.All(s => s == FormatSources.Keep);

    // What the format changes, as the end of "This rewrites N files in your music folder".
    private string Writes
    {
        get
        {
            var parts = new List<string>();
            if (new[] { _options.Titles, _options.Numbers, _options.Release, _options.Identifiers }.Any(s => s != FormatSources.Keep))
                parts.Add("their tags");
            if (_options.Artwork != FormatSources.Keep)
                parts.Add("their cover");
            if (_options.Move)
                parts.Add("where they are");
            return parts.Count == 0 ? "" : ": " + (parts.Count == 1 ? parts[0] : string.Join(", ", parts[..^1]) + " and " + parts[^1]);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _plan = await Api.GetFormatPlanAsync(Scope);
        }
        catch (Exception e) when (e is HttpRequestException or MelodexApiException)
        {
            _error = $"Couldn't see what it covers: {e.Message}";
        }
    }

    private Task CloseAsync() => _busy ? Task.CompletedTask : OnClose.InvokeAsync();

    private async Task StartAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            _started = await Api.StartFormatAsync(new StartFormat(Scope, _options));
        }
        catch (Exception e) when (e is HttpRequestException or MelodexApiException)
        {
            _error = e.Message;
        }
        _busy = false;
    }
}
