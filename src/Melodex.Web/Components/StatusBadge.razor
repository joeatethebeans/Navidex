@* Shows an album or track status as a coloured label. *@
<span class="badge @CssClass" title="@Hint">@Label</span>

@code {
    [Parameter] public AlbumStatus? Album { get; set; }
    [Parameter] public TrackStatus? Track { get; set; }

    private string CssClass => Album?.ToString().ToLowerInvariant() ?? Track switch
    {
        TrackStatus.OwnedElsewhere => "ownedElsewhere",
        { } t => t.ToString().ToLowerInvariant(),
        null => "neutral",
    };

    private string? Hint => Track == TrackStatus.Elsewhere
        ? "On a release shown in full, or one you have. This kind of release is shown for new songs only (Settings → General), so it doesn't count here."
        : null;

    private string Label => Album switch
    {
        AlbumStatus.Complete => "Owned",
        AlbumStatus.Partial => "Partly owned",
        AlbumStatus.Covered => "Covered",
        AlbumStatus.Missing => "Missing",
        _ => Track switch
        {
            TrackStatus.Owned => "Owned",
            TrackStatus.OwnedElsewhere => "On another album",
            TrackStatus.Missing => "Missing",
            TrackStatus.Ignored => "Ignored",
            TrackStatus.Elsewhere => "Elsewhere",
            _ => "",
        },
    };
}
