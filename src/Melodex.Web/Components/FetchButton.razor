@implements IDisposable
@inject RequestTracker Tracker
@inject AuthState Auth

@*
    Asks for an artist, album or track to be fetched, or shows how that's going. The other actions for the same thing
    (play, listen, ignore and so on) are its child content: they go once it's asked for, leaving the status chip.
*@
@if (Tracker.Find(Kind, Id) is { } request)
{
    <a class="badge @Format.RequestBadge(request)" href="activity?open=@request.Id" title="@request.Detail">@Format.RequestLabel(request)</a>
    @if (!request.Active && Auth.May(UserPermissions.Request))
    {
        <IconButton Icon="retry" Large="Large" Title="@(ScanStatus.Reading ? WaitHint : "Try again")" Disabled="@(_busy || ScanStatus.Reading)" OnClick="GetAsync" />
    }
}
else
{
    @ChildContent
    @if (!Auth.May(UserPermissions.Request))
    {
    }
    else if (Primary)
    {
        <button class="primary" disabled="@(_busy || ScanStatus.Reading)" title="@(ScanStatus.Reading ? WaitHint : Hint)" @onclick="GetAsync">@Label</button>
    }
    else
    {
        <IconButton Icon="get" Large="Large" Label="@(Large ? Label : null)" Title="@(ScanStatus.Reading ? WaitHint : Hint ?? Label)" Disabled="@(_busy || ScanStatus.Reading)" OnClick="GetAsync" />
    }
}
@if (_error is not null)
{
    <span class="error small" title="@_error">@_error</span>
}

@code {
    [Parameter, EditorRequired] public RequestKind Kind { get; set; }
    [Parameter, EditorRequired] public Guid Id { get; set; }
    [Parameter] public Guid? EditionId { get; set; }
    [Parameter] public string Label { get; set; } = "Get";
    [Parameter] public string? Hint { get; set; }
    [Parameter] public bool Primary { get; set; }

    /// <summary>As big as a page head's other buttons, with its label.</summary>
    [Parameter] public bool Large { get; set; }

    /// <summary>The other actions, shown until it's asked for.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private const string WaitHint = "The library is being scanned. Wait until it has read your files, so Melodex knows what you already have.";

    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        Tracker.Changed += Refresh;
        ScanStatus.ReadingChanged += Refresh;
        await Tracker.EnsureLoadedAsync();
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private async Task GetAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            await Tracker.CreateAsync(new CreateRequest(Kind, Id, EditionId));
        }
        catch (MelodexApiException e)
        {
            _error = e.Message;
        }
        _busy = false;
    }

    public void Dispose()
    {
        Tracker.Changed -= Refresh;
        ScanStatus.ReadingChanged -= Refresh;
    }
}
