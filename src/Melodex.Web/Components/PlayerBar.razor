@inject AuthState Auth
@implements IDisposable
@inject Player Player

@*
    The player along the bottom of every page, once something has been played: what's playing on the left, the controls
    in the middle, and the queue, lyrics and volume on the right. The cover, or the expand button, opens the full-screen
    player.
*@
@if (Player.Queue.Count > 0)
{
    var now = Player.Now;
    <div class="player-space"></div>
    <div class="player">
        @if (_showQueue)
        {
            <div class="player-queue card"><PlayerQueue /></div>
        }
        <div class="player-bar">
            <div class="player-track">
                <button class="player-art" title="Open the full-screen player" @onclick="() => Player.Expand()">
                    <Cover Url="@now?.CoverUrl" />
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 15l6-6 6 6" /></svg>
                </button>
                <div class="player-text">
                    @if (now is null)
                    {
                        <div class="muted">End of the queue</div>
                    }
                    else
                    {
                        <div class="ellipsis player-title">
                            @if (now.AlbumHref is { } album) { <a href="@album">@now.Title</a> } else { @now.Title }
                        </div>
                        <div class="muted small ellipsis">
                            @if (now.ArtistId is { } artist) { <a class="muted" href="artists/@artist">@now.ArtistCredit</a> } else { @now.ArtistCredit }
                            @if (now.ListenId is not null)
                            {
                                <span> · </span>
                                @switch (now.ListenState)
                                {
                                    case ListenNowState.Requested or ListenNowState.Fetching:
                                        <span title="@now.Detail">Fetching to listen…</span>
                                        break;
                                    case ListenNowState.Playable:
                                        <span title="Fetched to listen to; it's deleted if you don't play it for a while">Not in library</span>
                                        <button class="link small" @onclick="() => Player.AddToLibraryAsync(now)">Add to library</button>
                                        break;
                                    case ListenNowState.Importing:
                                        <span>Adding to library…</span>
                                        break;
                                    case ListenNowState.InLibrary:
                                        <span>In library</span>
                                        break;
                                    default:
                                        <span class="error" title="@now.Detail">@(now.Detail ?? "Couldn't fetch it")</span>
                                        break;
                                }
                            }
                        </div>
                    }
                    @if (Player.Error is { } error)
                    {
                        <div class="error small" title="@error">@error</div>
                    }
                </div>
            </div>
            <div class="player-centre">
            <div class="player-controls">
                <button class="icon hide-narrow" title="Previous" disabled="@(now is null)" @onclick="Player.PreviousAsync">
                    <svg viewBox="0 0 24 24"><path d="M6 5v14M18 5 8 12l10 7z" /></svg>
                </button>
                <button class="icon play" title="@(Player.Playing ? "Pause" : "Play")" disabled="@(now is null)" @onclick="Player.ToggleAsync">
                    @if (now?.Waiting == true)
                    {
                        <span class="spinner"></span>
                    }
                    else if (Player.Playing)
                    {
                        <svg viewBox="0 0 24 24"><path d="M8 5v14M16 5v14" /></svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24"><path d="M7 4.5v15L19 12z" /></svg>
                    }
                </button>
                <button class="icon" title="Next" disabled="@(now is null || Player.Current + 1 >= Player.Queue.Count)" @onclick="Player.NextAsync">
                    <svg viewBox="0 0 24 24"><path d="M18 5v14M6 5l10 7-10 7z" /></svg>
                </button>
            </div>
            <div class="player-seek">
                <span class="small muted time">@Format.Duration(Player.Position)</span>
                <input type="range" min="0" max="@Math.Max(Player.Duration, 1).ToString("0")" step="1" value="@Player.Position.ToString("0")"
                       disabled="@(now is null || now.Waiting)" aria-label="Position" @onchange="SeekAsync" />
                <span class="small muted time">@Format.Duration(Player.Duration)</span>
            </div>
            </div>
            <div class="player-end">
                @if (now is not null && Auth.May(UserPermissions.Listen))
                {
                    <button class="icon hide-narrow" title="@(PlaylistNames.ItemOf(now) is null ? "Add it to your library to put it in a playlist" : "Add to a playlist")"
                        disabled="@(PlaylistNames.ItemOf(now) is null)" @onclick="() => _adding = now">
                    <svg viewBox="0 0 24 24"><path d="M4 6h11M4 11h11M4 16h6" /><circle cx="16.5" cy="17.5" r="2.5" /><path d="M19 17.5V9l2.5 1" /></svg>
                </button>
                }
                <button class="icon hide-narrow" title="Lyrics" @onclick="() => Player.Expand(PlayerPanel.Lyrics)">
                    <svg viewBox="0 0 24 24"><path d="M4 5h16v11H9l-5 4z" /><path d="M8 9h8M8 12h5" /></svg>
                </button>
                <button class="icon @(_showQueue ? "on" : "")" title="Queue (@Player.Queue.Count)" @onclick="() => _showQueue = !_showQueue">
                    <svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h10M4 18h10M17 15v6l4-3z" /></svg>
                </button>
                <VolumeControl Class="hide-narrow" />
                <button class="icon" title="Open the full-screen player" @onclick="() => Player.Expand()">
                    <svg viewBox="0 0 24 24"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
                </button>
                <button class="icon hide-narrow" title="Stop and clear the queue" @onclick="Player.ClearAsync">
                    <svg viewBox="0 0 24 24"><rect x="6" y="6" width="12" height="12" rx="1.5" /></svg>
                </button>
            </div>
        </div>
    </div>
    @if (Player.Expanded)
    {
        <NowPlaying />
    }
}

@if (_adding is { } adding && PlaylistNames.ItemOf(adding) is { } item)
{
    <AddToPlaylistDialog Name="@adding.Title" Songs="[item]" OnClose="() => _adding = null" />
}

@code {
    private bool _showQueue;
    private PlayerEntry? _adding;

    protected override void OnInitialized()
    {
        Player.Changed += Redraw;
        Player.TimeChanged += Redraw;
    }

    private void Redraw() => InvokeAsync(StateHasChanged);

    private Task SeekAsync(ChangeEventArgs e) =>
        double.TryParse(e.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var s) ? Player.SeekAsync(s) : Task.CompletedTask;

    public void Dispose()
    {
        Player.Changed -= Redraw;
        Player.TimeChanged -= Redraw;
    }
}
