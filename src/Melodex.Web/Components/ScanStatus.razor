@implements IDisposable
@inject MelodexClient Api
@inject AuthState Auth

@*
    Shows the scan button, or what the running task is doing, with a menu of the other things done to the whole library:
    matching files again and formatting. Polls while a task runs.
*@
<div class="row small">
    @if (_status?.CurrentTask is { } task)
    {
        <a class="muted" href="activity" title="See what it's doing">@(task.Progress ?? "Starting…")</a>
    }
    else if (_status?.Preparing == true)
    {
        <span class="muted preparing" title="Melodex has just started and is working out your library's artists, albums and tracks. The first time takes a while on a big library; after that they're kept, so it's quick.">
            <span class="spinner" aria-hidden="true"></span> Getting your library ready…
        </span>
    }
    else if (_status?.LastScan is { State: TaskState.Failed } failed)
    {
        <a class="error" href="settings/log" title="@failed.Error">Scan failed: @failed.Error</a>
    }
    else if (_status is not null)
    {
        <span class="muted hide-narrow scan-count" title="@_status.LastScan?.Progress">@_status.Files files@(_status.Review > 0 ? $", {_status.Review} to review" : "")</span>
    }
    @if (Auth.May(UserPermissions.Scan))
    {
    <div class="split-button">
        <button class="primary" disabled="@(_status?.CurrentTask is not null)" title="Read new and changed files, and match them" @onclick="() => ScanAsync(Rematch.None)">Scan library</button>
        <button class="primary more" title="More ways to scan, and formatting" aria-label="More ways to scan, and formatting" aria-haspopup="menu"
                aria-expanded="@(_menu ? "true" : "false")" @onclick="() => _menu = !_menu">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
        </button>
        @if (_menu)
        {
            <div class="menu-backdrop" @onclick="() => _menu = false"></div>
            <div class="menu right scan-menu" role="menu">
                <button type="button" role="menuitem" @onclick="() => ScanAsync(Rematch.None)">
                    Scan for changes<span class="muted small">Read new and changed files, and match them</span>
                </button>
                <button type="button" role="menuitem" @onclick="() => ScanAsync(Rematch.Unmatched)">
                    Match unmatched files again<span class="muted small">Those under review and deferred ones, as well as changes</span>
                </button>
                <button type="button" role="menuitem" @onclick="() => Open(Confirm.Rematch)">
                    Match everything again…<span class="muted small">Every file but those you matched, excluded or hid</span>
                </button>
                @if (Auth.May(UserPermissions.Format))
                {
                    <hr />
                    <button type="button" role="menuitem" @onclick="() => Open(Confirm.Format)">
                        Format the whole library…<span class="muted small">Rewrite files' tags, covers and where they live</span>
                    </button>
                }
                @if (Auth.May(UserPermissions.Review) && _status is { Review: > 0 } or { Excluded: > 0 } or { Deferred: > 0 } or { Hidden: > 0 })
                {
                    <hr />
                    <a role="menuitem" href="review" @onclick="() => _menu = false">
                        Review files<span class="muted small">@ReviewSummary</span>
                    </a>
                }
            </div>
        }
    </div>
    }
</div>

@if (_confirm == Confirm.Rematch)
{
    <Dialog Title="Match everything again?" OnClose="() => _confirm = null" Alert="true">
        <p>
            Every file is matched from scratch, as a first scan would, except those you matched, excluded or hid yourself.
            Over a big library this takes a while, and until each file is matched again it doesn't count as owned.
        </p>
        <p class="muted small">Nothing in your music folder changes.</p>
        <div class="toolbar dialog-buttons">
            <button @onclick="() => _confirm = null">Cancel</button>
            <button class="primary" @onclick="async () => { _confirm = null; await ScanAsync(Rematch.All); }">Match everything again</button>
        </div>
    </Dialog>
}
else if (_confirm == Confirm.Format)
{
    <FormatDialog Scope="new FormatScope(FormatScopeKind.Library, null)" Name="the whole library" OnClose="() => _confirm = null" />
}

@code {
    private LibraryStatus? _status;
    private bool _menu;

    private enum Confirm { Rematch, Format }

    private Confirm? _confirm;

    private string ReviewSummary => string.Join(", ", new[]
    {
        (_status!.Review, "to review"), (_status.Deferred, "deferred"), (_status.Excluded, "excluded"), (_status.Hidden, "hidden"),
    }.Where(p => p.Item1 > 0).Select(p => $"{p.Item1} {p.Item2}"));

    private void Open(Confirm confirm)
    {
        _menu = false;
        _confirm = confirm;
    }
    private Timer? _timer;
    private bool _wasRunning;
    private int _polls;

    /// <summary>
    /// Raised every 15 seconds while a task runs and once when it finishes, so pages can reload: artists show up as
    /// their files are matched, not only at the end of a long scan.
    /// </summary>
    public static event Action? LibraryChanged;

    /// <summary>A scan is reading the library, so nothing can be asked for until it knows what you have.</summary>
    public static bool Reading { get; private set; }

    /// <summary>Raised when <see cref="Reading"/> changes.</summary>
    public static event Action? ReadingChanged;

    /// <summary>The server has just started and is working out the library's lists for the first time.</summary>
    public static bool Preparing { get; private set; }

    /// <summary>Raised when <see cref="Preparing"/> changes.</summary>
    public static event Action? PreparingChanged;

    /// <summary>For other things that change the library, such as a request being filed.</summary>
    public static void RaiseLibraryChanged() => LibraryChanged?.Invoke();

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _timer = new Timer(_ => InvokeAsync(RefreshAsync), null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    private async Task RefreshAsync()
    {
        try
        {
            _status = await Api.GetLibraryStatusAsync();
        }
        catch (HttpRequestException)
        {
            return;
        }
        if (_status is not null && _status.Reading != Reading)
        {
            Reading = _status.Reading;
            ReadingChanged?.Invoke();
        }
        if (_status is not null && _status.Preparing != Preparing)
        {
            Preparing = _status.Preparing;
            PreparingChanged?.Invoke();
            if (!Preparing)
                LibraryChanged?.Invoke();
        }
        var running = _status?.CurrentTask is not null;
        if (_wasRunning && !running || running && ++_polls % 5 == 0)
            LibraryChanged?.Invoke();
        _wasRunning = running;
        StateHasChanged();
    }

    private async Task ScanAsync(Rematch rematch)
    {
        _menu = false;
        await Api.ScanLibraryAsync(rematch);
        Reading = true;
        ReadingChanged?.Invoke();
        await RefreshAsync();
    }

    public void Dispose() => _timer?.Dispose();
}
