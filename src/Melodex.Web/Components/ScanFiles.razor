@implements IDisposable
@inject MelodexClient Api
@inject Preferences Prefs
@using Microsoft.AspNetCore.Components.Web.Virtualization

@*
    What a scan is doing, file by file: the file's name while it's read and matched, then the song it turned out to be.
    Each file keeps its place, so the list can be watched filling in.
*@
@if (_files is null)
{
    <Loading Inline="true" />
}
else if (_files.Count == 0)
{
    <div class="muted small">Nothing new to read: every file is as it was at the last scan.</div>
}
else
{
    <div class="row scan-files-head">
        <span class="muted small">@Summary</span>
        <button class="link small" title="Reverse the list" @onclick="FlipAsync">
            <svg class="sort-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4v16M3 16l4 4 4-4M17 20V4M13 8l4-4 4 4" /></svg>
            @(_newestFirst ? "Latest at the top" : "Latest at the bottom")
        </button>
    </div>
    <div class="scan-files">
        <Virtualize Items="Shown" Context="file" ItemSize="52" OverscanCount="10">
            <div @key="file.Path" class="scan-file @file.State.ToString().ToLowerInvariant() @(file.Seq > _freshAfter ? "fresh" : "")">
                @if (file.State == ScanFileState.Matched)
                {
                    @if (file.AlbumId is { } album) { <a href="albums/@album" tabindex="-1"><Cover Url="@file.CoverUrl" /></a> }
                    else { <Cover Url="@file.CoverUrl" /> }
                    <div class="scan-file-text">
                        <div class="ellipsis" title="@file.Path">@file.Title</div>
                        <div class="muted small ellipsis">
                            @if (file.ArtistId is { } artist) { <a href="artists/@artist">@file.ArtistCredit</a> } else { @file.ArtistCredit }
                            @if (file.AlbumId is { } id) { <span> · <a href="albums/@id">@file.AlbumTitle</a></span> }
                        </div>
                    </div>
                    <span class="badge owned">Matched</span>
                }
                else
                {
                    <div class="scan-file-icon">
                        @if (file.State is ScanFileState.Reading or ScanFileState.Matching) { <span class="spinner"></span> }
                        else
                        {
                            <svg viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6z" /><path d="M14 3v4h4" /></svg>
                        }
                    </div>
                    <div class="scan-file-text">
                        <div class="ellipsis" title="@file.Path">@System.IO.Path.GetFileName(file.Path)</div>
                        <div class="muted small ellipsis" title="@(file.Detail ?? file.Path)">
                            @(file.Detail ?? (file.Title is not null ? $"{file.Title}{(file.ArtistCredit is null ? "" : $" · {file.ArtistCredit}")}" : System.IO.Path.GetDirectoryName(file.Path)))
                        </div>
                    </div>
                    @switch (file.State)
                    {
                        case ScanFileState.Reading:
                            <span class="badge active">Reading</span>
                            break;
                        case ScanFileState.Queued:
                            <span class="badge neutral">Read</span>
                            break;
                        case ScanFileState.Matching:
                            <span class="badge active">Matching</span>
                            break;
                        case ScanFileState.Review:
                            <a class="badge partial" href="review">To review</a>
                            break;
                        default:
                            <span class="badge neutral">Waiting</span>
                            break;
                    }
                }
            </div>
        </Virtualize>
    </div>
}

@code {
    /// <summary>Whether the scan is still running, so the list keeps updating.</summary>
    [Parameter] public bool Active { get; set; }

    private const string NewestFirstKey = "scanNewestFirst";

    // In the order the scan first saw them; a change replaces the file in its place.
    private List<ScanFile>? _files;
    private readonly Dictionary<string, int> _index = new(StringComparer.Ordinal);
    private List<ScanFile> _reversed = [];
    private Guid _scan;
    private long _latest;

    // Changes after this arrived in the last poll; a file matched in it gets a moment's highlight.
    private long _freshAfter = long.MaxValue;

    private bool _newestFirst;
    private Timer? _timer;

    private ICollection<ScanFile> Shown => _newestFirst ? _reversed : _files!;

    private string Summary
    {
        get
        {
            var matched = _files!.Count(f => f.State == ScanFileState.Matched);
            var review = _files!.Count(f => f.State == ScanFileState.Review);
            return $"{_files!.Count:N0} files · {matched:N0} matched" + (review > 0 ? $" · {review:N0} to review" : "");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _newestFirst = await Prefs.GetAsync(NewestFirstKey, false);
        await LoadAsync();
        _timer = new Timer(_ => InvokeAsync(async () =>
        {
            if (!Active)
                return;
            await LoadAsync();
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(1.5), TimeSpan.FromSeconds(1.5));
    }

    private async Task LoadAsync()
    {
        ScanFeedPage page;
        try
        {
            page = await Api.GetScanFilesAsync(_files is null ? 0 : _latest);
            // A new scan has started: its changes since our number aren't the whole list, so ask for all of it.
            if (_files is not null && page.Scan != _scan)
                page = await Api.GetScanFilesAsync(0);
        }
        catch (HttpRequestException)
        {
            _files ??= [];
            return;
        }
        if (_files is null || page.Scan != _scan)
        {
            _files = [];
            _index.Clear();
            _scan = page.Scan;
            _freshAfter = long.MaxValue;
        }
        else
            _freshAfter = _latest;
        foreach (var file in page.Files)
        {
            if (_index.TryGetValue(file.Path, out var i))
                _files[i] = file;
            else
            {
                _index[file.Path] = _files.Count;
                _files.Add(file);
            }
        }
        _latest = page.Latest;
        if (_newestFirst && page.Files.Count > 0)
            _reversed = Enumerable.Reverse(_files).ToList();
    }

    private async Task FlipAsync()
    {
        _newestFirst = !_newestFirst;
        if (_newestFirst)
            _reversed = Enumerable.Reverse(_files!).ToList();
        await Prefs.SetAsync(NewestFirstKey, _newestFirst);
    }

    public void Dispose() => _timer?.Dispose();
}
