@* A dialog over the page, closed by its buttons, Escape, or a click outside it. *@
<div class="dialog-backdrop" @onclick="CloseAsync">
    <div class="dialog @Class" role="@(Alert ? "alertdialog" : "dialog")" aria-modal="true" aria-labelledby="@_titleId" @onclick:stopPropagation="true"
         @onkeydown="KeyAsync" tabindex="-1" @ref="_dialog">
        <h2 id="@_titleId">@Title</h2>
        @ChildContent
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string? Class { get; set; }

    /// <summary>Asks something that needs an answer, such as confirming an action, rather than showing a form.</summary>
    [Parameter] public bool Alert { get; set; }

    private readonly string _titleId = $"dialog-{Guid.NewGuid():N}";
    private ElementReference _dialog;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await _dialog.FocusAsync();
    }

    private Task CloseAsync() => OnClose.InvokeAsync();

    private Task KeyAsync(KeyboardEventArgs e) => e.Key == "Escape" ? CloseAsync() : Task.CompletedTask;
}
