@inject MelodexClient Api
@inject AuthState Auth

@* For a background task that's queued or running: move it while it waits, pause or resume it, and cancel it. *@
@if (Item.Active && Auth.May(UserPermissions.Scan))
{
    @if (Queue is not null && Item.State == TaskState.Queued && _index >= 0)
    {
        <IconButton Icon="up" Class="small" Title="Move up the queue" Disabled="@(_busy || _index == 0)" OnClick="() => MoveAsync(_index - 1)" />
        <IconButton Icon="down" Class="small" Title="Move down the queue" Disabled="@(_busy || _index == Queue.Count - 1)" OnClick="() => MoveAsync(_index + 2)" />
    }
    @if (Item.Paused)
    {
        <IconButton Icon="play" Class="small" Title="Resume" Disabled="_busy" OnClick="() => RunAsync(() => Api.ResumeTaskAsync(Item.Id))" />
    }
    else
    {
        <IconButton Icon="pause" Class="small" Title="@PauseTitle" Disabled="_busy" OnClick="() => RunAsync(() => Api.PauseTaskAsync(Item.Id))" />
    }
    <IconButton Icon="cancel" Class="small" Title="Cancel" Disabled="_busy" OnClick="() => RunAsync(() => Api.CancelTaskAsync(Item.Id))" />
}

@code {
    [Parameter, EditorRequired] public TaskInfo Item { get; set; } = null!;
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>Queued tasks, in the order they'll run.</summary>
    [Parameter] public IReadOnlyList<TaskInfo>? Queue { get; set; }

    private bool _busy;
    private int _index = -1;

    // A scan picks up where it stopped; anything else runs again from the start.
    private string PauseTitle => Item.State == TaskState.Running
        ? Item.Kind == "library-scan" ? "Pause: it carries on from here when resumed" : "Pause: it starts again when resumed"
        : "Pause";

    protected override void OnParametersSet() => _index = Queue?.ToList().FindIndex(t => t.Id == Item.Id) ?? -1;

    private Task MoveAsync(int place) => RunAsync(() => Api.MoveTaskAsync(Item.Id, place < Queue!.Count ? Queue[place].Id : null));

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        try
        {
            await action();
        }
        catch (MelodexApiException)
        {
            // It finished or started meanwhile; the refresh shows where it is now.
        }
        _busy = false;
        await OnChanged.InvokeAsync();
    }
}
