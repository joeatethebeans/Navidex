@inherits LayoutComponentBase
@implements IDisposable
@inject AuthState Auth

<header class="topbar">
    <a class="brand" href="">Navidex</a>
    <nav class="nav">
        <NavLink href="" Match="NavLinkMatch.All">Library</NavLink>
        <NavLink href="activity">Activity</NavLink>
        <NavLink href="downloads">Downloads</NavLink>
        @if (Auth.May(UserPermissions.Review))
        {
            <NavLink href="review">Review</NavLink>
        }
        <NavLink href="search">Search</NavLink>
        @if (Auth.May(UserPermissions.Settings) || Auth.May(UserPermissions.Users) || Auth.May(UserPermissions.Keys))
        {
            <NavLink href="@SettingsHref">Settings</NavLink>
        }
    </nav>
    <span class="spacer"></span>
    <ScanStatus />
    <AccountMenu />
</header>

<main>
    @Body
</main>

@if (Auth.May(UserPermissions.Listen))
{
    <PlayerBar />
}

@code {
    // The first settings tab they may open.
    private string SettingsHref => Auth.May(UserPermissions.Settings) ? "settings" : Auth.May(UserPermissions.Users) ? "settings/users" : "settings/api";

    protected override void OnInitialized() => Auth.Changed += Redraw;

    private void Redraw() => InvokeAsync(StateHasChanged);

    public void Dispose() => Auth.Changed -= Redraw;
}
