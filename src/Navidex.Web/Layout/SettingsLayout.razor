@inherits LayoutComponentBase
@layout MainLayout

@* Settings, the log and plugins, as sections listed down the left; across the top on narrow screens. *@
<h1>Settings</h1>
<div class="settings-page">
    <nav class="settings-nav" aria-label="Settings sections">
        <NavLink href="settings" Match="NavLinkMatch.All">General</NavLink>
        <NavLink href="settings/log">Log</NavLink>
        <NavLink href="settings/plugins">Plugins</NavLink>
    </nav>
    <div class="settings-body">@Body</div>
</div>
