@page "/"
@implements IDisposable
@inject NavidexClient Api
@inject Preferences Prefs

<PageTitle>Library · Navidex</PageTitle>

<h1>Library</h1>
<p class="muted">Every artist in your music folder, and how much of their catalogue you have.</p>

@if (_artists is null)
{
    <p class="muted">Loading…</p>
}
else if (_artists.Count == 0)
{
    <div class="empty card">No artists yet. Scan the library to read your music folder.</div>
}
else
{
    <div class="toolbar">
        <input type="search" placeholder="Filter artists" @bind="_filter" @bind:event="oninput" />
        <label class="toggle"><input type="checkbox" checked="@Prefs.OnlyMissing" @onchange="e => Prefs.SetOnlyMissingAsync((bool)e.Value!)" /> Only missing</label>
    </div>
    @if (!Visible.Any())
    {
        <div class="empty card">@(Prefs.OnlyMissing ? "Nothing missing" : "No artists") @(_filter.Length > 0 ? "matches that filter." : "right now.")</div>
    }
    <div class="tiles">
        @foreach (var artist in Visible)
        {
            var total = artist.OwnedAlbums + artist.MissingAlbums;
            <a class="tile" href="artists/@artist.Id" title="@Title(artist)">
                <Cover Url="@artist.ImageUrl" Artist="true" />
                <div class="tile-name">@artist.Name</div>
                <div class="meter" title="@artist.OwnedAlbums of @total"><span style="width:@(total == 0 ? 100 : 100 * artist.OwnedAlbums / total)%"></span></div>
                <div class="muted small">
                    @artist.OwnedAlbums of @total owned@(artist.MissingAlbums > 0 ? $" · {artist.MissingAlbums} missing" : "")@(artist.PartialAlbums > 0 ? $" · {artist.PartialAlbums} partly owned" : "")
                </div>
            </a>
        }
    </div>
}

@code {
    private IReadOnlyList<LibraryArtist>? _artists;
    private string _filter = "";

    private IEnumerable<LibraryArtist> Visible => _artists!
        .Where(a => _filter.Length == 0 || a.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase))
        .Where(a => !Prefs.OnlyMissing || a.MissingAlbums > 0 || a.PartialAlbums > 0);

    private static string Title(LibraryArtist a) => a.Disambiguation is null ? a.Name : $"{a.Name} ({a.Disambiguation})";

    protected override async Task OnInitializedAsync()
    {
        ScanStatus.LibraryChanged += Reload;
        await Prefs.LoadAsync();
        _artists = await Api.GetLibraryArtistsAsync();
    }

    private void Reload() => InvokeAsync(async () =>
    {
        _artists = await Api.GetLibraryArtistsAsync();
        StateHasChanged();
    });

    public void Dispose() => ScanStatus.LibraryChanged -= Reload;
}
