@page "/artists/{Id:guid}"
@implements IDisposable
@inject NavidexClient Api

<PageTitle>@(_artist?.Name ?? "Artist") · Navidex</PageTitle>

@if (_notFound)
{
    <div class="empty card">That artist isn't in the catalogue.</div>
}
else if (_artist is null)
{
    <p class="muted">Loading…</p>
}
else
{
    <h1>@_artist.Name</h1>
    <div class="row muted small">
        @if (_artist.Disambiguation is not null) { <span>@_artist.Disambiguation</span> }
        @if (_artist.Country is not null) { <span>@_artist.Country</span> }
        <span>@Owned owned · @Missing missing@(Covered > 0 ? $" · {Covered} covered" : "")</span>
        <ProviderIds Ids="_artist.Ids" Entity="artist" />
    </div>

    @if (_artist.Albums.Count == 0)
    {
        <div class="empty card">No albums in the catalogue for this artist.</div>
    }

    @foreach (var group in Shown.GroupBy(a => a.Type).OrderBy(g => g.Key))
    {
        <h2>@Format.TypeName(group.Key)</h2>
        <AlbumTable Albums="group.ToList()" OnIgnore="ToggleIgnoreAsync" />
    }

    @if (Hidden.Any())
    {
        <details>
            <summary>@Hidden.Count() more hidden by the default filters (live, compilations, remixes, bootlegs…)</summary>
            <AlbumTable Albums="Hidden.ToList()" OnIgnore="ToggleIgnoreAsync" ShowSecondary="true" />
        </details>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private ArtistDetail? _artist;
    private bool _notFound;

    // Owned albums always show; the default filters only hide albums you don't have.
    private IEnumerable<AlbumSummary> Shown => _artist!.Albums.Where(a => !a.HiddenByDefault || a.Status is AlbumStatus.Complete or AlbumStatus.Partial);
    private IEnumerable<AlbumSummary> Hidden => _artist!.Albums.Except(Shown);
    private int Owned => _artist!.Albums.Count(a => a.Status is AlbumStatus.Complete or AlbumStatus.Partial);
    private int Missing => _artist!.Albums.Count(a => a.Status == AlbumStatus.Missing && !a.HiddenByDefault && !a.Ignored);
    private int Covered => _artist!.Albums.Count(a => a.Status == AlbumStatus.Covered && !a.HiddenByDefault);

    protected override async Task OnParametersSetAsync()
    {
        ScanStatus.LibraryChanged -= Reload;
        ScanStatus.LibraryChanged += Reload;
        _artist = await Api.GetArtistAsync(Id);
        _notFound = _artist is null;
    }

    private void Reload() => InvokeAsync(async () =>
    {
        _artist = await Api.GetArtistAsync(Id);
        StateHasChanged();
    });

    private async Task ToggleIgnoreAsync(AlbumSummary album)
    {
        await Api.SetAlbumIgnoredAsync(album.Id, !album.Ignored);
        _artist = await Api.GetArtistAsync(Id);
    }

    public void Dispose() => ScanStatus.LibraryChanged -= Reload;
}
