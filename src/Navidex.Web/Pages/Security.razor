@page "/settings/security"
@layout SettingsLayout
@inject NavidexClient Api
@inject AuthState Auth
@using Microsoft.JSInterop
@inject IJSRuntime Js

<PageTitle>Security · Navidex</PageTitle>

@if (_keys is null || Auth.Status is not { } status)
{
    <Loading />
}
else
{
    <div class="plugin-sections">
        <section class="panel" aria-label="Sign-in">
            <header class="panel-head">
                <div class="panel-title">
                    <h2>Sign-in</h2>
                    <p class="muted small">
                        @if (status.SignedIn)
                        {
                            <text>Signed in as <strong>@status.Username</strong>.</text>
                        }
                        else
                        {
                            <text>Let in from your local network, as <strong>@status.Username</strong>.</text>
                        }
                    </p>
                </div>
                @if (status.SignedIn)
                {
                    <button class="small" @onclick="SignOutAsync">Sign out</button>
                }
            </header>
            <div class="panel-body">
                <label class="auth-check">
                    <input type="checkbox" checked="@status.SkipOnLocalNetwork" @onchange="e => SetSkipAsync((bool)e.Value!)" />
                    <span>
                        Don't ask on my local network
                        <span class="muted small">
                            Anyone on your home network can use Navidex without signing in. Calls from further away, or through a reverse proxy, still need the password.
                            @(status.Local ? "This browser is on your local network." : "This browser isn't on your local network, or came through a proxy.")
                        </span>
                    </span>
                </label>

                <h3>Change username or password</h3>
                <div class="field">
                    <label class="field-label" for="account-username">Username</label>
                    <input id="account-username" type="text" autocomplete="username" @bind="_username" />
                </div>
                <div class="field">
                    <label class="field-label" for="account-new">New password</label>
                    <input id="account-new" type="password" autocomplete="new-password" placeholder="Leave empty to keep it" @bind="_newPassword" @bind:event="oninput" />
                    <span class="muted small">Changing it signs out every other browser.</span>
                </div>
                <div class="field">
                    <label class="field-label" for="account-current">Current password</label>
                    <input id="account-current" type="password" autocomplete="current-password" @bind="_currentPassword" @bind:event="oninput" />
                </div>
                <div class="toolbar">
                    <button class="primary" disabled="@(_busy || _currentPassword.Length == 0)" @onclick="SaveAccountAsync">Save</button>
                    @if (_accountSaved) { <span class="muted small">Saved.</span> }
                    @if (_accountError is not null) { <span class="error small">@_accountError</span> }
                </div>
            </div>
        </section>

        <section class="panel" aria-label="API keys">
            <header class="panel-head">
                <div class="panel-title">
                    <h2>API keys</h2>
                    <p class="muted small">
                        Apps use a key to call Navidex, sent in the <code>X-Api-Key</code> header. Give each app its own, with only what it needs, so
                        you can revoke one without the others. See the <a href="api/docs" target="_blank" rel="noopener">API reference</a>.
                    </p>
                </div>
                <button class="primary small" @onclick="StartNewKey">New key</button>
            </header>
            @if (_keys.Count == 0)
            {
                <div class="panel-empty muted small">No keys yet. Make one for each app you connect.</div>
            }
            else
            {
                <div class="plugin-grid">
                    @foreach (var key in _keys)
                    {
                        <div class="plugin-card">
                            <div class="plugin-top">
                                <strong class="ellipsis" title="@key.Name">@key.Name</strong>
                                <span class="spacer"></span>
                                <code class="small muted">@key.Prefix…</code>
                            </div>
                            <div class="scope-list">
                                @foreach (var scope in key.Scopes)
                                {
                                    <span class="badge neutral" title="@ScopeHelp(scope)">@scope</span>
                                }
                            </div>
                            <div class="muted small">
                                Made @Format.Ago(key.CreatedAt) · @(key.LastUsedAt is { } used ? $"last used {Format.Ago(used)}" : "never used")
                            </div>
                            <div class="plugin-actions">
                                <span class="spacer"></span>
                                <IconButton Icon="remove" Class="remove" Title="Revoke" OnClick="() => _revoking = key" />
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    </div>

    @if (_making)
    {
        <Dialog Title="New API key" OnClose="() => _making = false">
            <label class="field">
                <span class="field-label">Name</span>
                <input type="text" placeholder="The app it's for" @bind="_keyName" @bind:event="oninput" />
                <span class="muted small">Requests the app makes are credited to this name on the Activity page.</span>
            </label>
            <div class="field-label">What it can do</div>
            @foreach (var (scope, help) in ScopeHelps)
            {
                <label class="dialog-choice">
                    <input type="checkbox" checked="@_keyScopes.Contains(scope)" @onchange="e => ToggleScope(scope, (bool)e.Value!)" />
                    <span><strong>@scope</strong><span class="muted small">@help</span></span>
                </label>
            }
            @if (_keyError is not null) { <p class="error small">@_keyError</p> }
            <div class="toolbar dialog-buttons">
                <button @onclick="() => _making = false">Cancel</button>
                <button class="primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_keyName) || _keyScopes.Count == 0)" @onclick="MakeKeyAsync">Make key</button>
            </div>
        </Dialog>
    }

    @if (_made is { } made)
    {
        <Dialog Title="@($"Key for {made.Info.Name}")" OnClose="() => _made = null">
            <p>Copy it into the app now. Navidex keeps only a fingerprint of it, so it can't show it again.</p>
            <div class="secret-box">
                <code>@made.Key</code>
                <IconButton Icon="copy" Title="Copy" Confirm="true" OnClick="() => CopyAsync(made.Key)" />
            </div>
            <div class="toolbar dialog-buttons"><button class="primary" @onclick="() => _made = null">Done</button></div>
        </Dialog>
    }

    @if (_revoking is { } revoking)
    {
        <Dialog Title="@($"Revoke {revoking.Name}?")" OnClose="() => _revoking = null" Alert="true">
            <p>Anything using this key is refused from now on. This can't be undone, but you can make a new key.</p>
            <div class="toolbar dialog-buttons">
                <button @onclick="() => _revoking = null">Cancel</button>
                <button class="danger" disabled="@_busy" @onclick="() => RevokeAsync(revoking)">Revoke</button>
            </div>
        </Dialog>
    }
}

@code {
    private IReadOnlyList<ApiKeyInfo>? _keys;
    private string _username = "";
    private string _newPassword = "";
    private string _currentPassword = "";
    private bool _accountSaved;
    private string? _accountError;
    private bool _busy;

    private bool _making;
    private string _keyName = "";
    private HashSet<string> _keyScopes = [];
    private string? _keyError;
    private CreatedApiKey? _made;
    private ApiKeyInfo? _revoking;

    private static readonly (string Scope, string Help)[] ScopeHelps =
    [
        ("read", "See the library, the catalogue, requests and listen-now tracks, and follow events."),
        ("request", "Ask for artists, albums and tracks, cancel and retry requests, and ignore albums and tracks."),
        ("listen", "Fetch tracks to listen to now, and play tracks you have."),
        ("admin", "Everything, including settings, plugins, keys and webhooks."),
    ];

    private static string ScopeHelp(string scope) => ScopeHelps.FirstOrDefault(s => s.Scope == scope).Help ?? "";

    protected override async Task OnInitializedAsync()
    {
        _username = Auth.Status?.Username ?? "";
        _keys = await Api.ListApiKeysAsync();
    }

    private async Task SetSkipAsync(bool skip)
    {
        await Api.SaveAccessSettingsAsync(new AccessSettings(skip));
        Auth.Set(await Api.GetAuthStatusAsync());
    }

    private async Task SaveAccountAsync()
    {
        _busy = true;
        _accountSaved = false;
        _accountError = null;
        try
        {
            await Api.UpdateLoginAsync(new UpdateLogin(_currentPassword, _username, _newPassword.Length > 0 ? _newPassword : null));
            _currentPassword = _newPassword = "";
            _accountSaved = true;
            Auth.Set(await Api.GetAuthStatusAsync());
        }
        catch (NavidexApiException e)
        {
            _accountError = e.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SignOutAsync()
    {
        await Api.SignOutAsync();
        Auth.Set(await Api.GetAuthStatusAsync());
    }

    private void StartNewKey()
    {
        _keyName = "";
        _keyScopes = ["read"];
        _keyError = null;
        _making = true;
    }

    private void ToggleScope(string scope, bool on)
    {
        if (on)
            _keyScopes.Add(scope);
        else
            _keyScopes.Remove(scope);
    }

    private async Task MakeKeyAsync()
    {
        _busy = true;
        _keyError = null;
        try
        {
            _made = await Api.CreateApiKeyAsync(new CreateApiKey(_keyName, ScopeHelps.Select(s => s.Scope).Where(_keyScopes.Contains).ToList()));
            _making = false;
            _keys = await Api.ListApiKeysAsync();
        }
        catch (NavidexApiException e)
        {
            _keyError = e.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RevokeAsync(ApiKeyInfo key)
    {
        _busy = true;
        try
        {
            await Api.RevokeApiKeyAsync(key.Id);
            _revoking = null;
            _keys = await Api.ListApiKeysAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CopyAsync(string text) => await Js.InvokeVoidAsync("navigator.clipboard.writeText", text);
}
