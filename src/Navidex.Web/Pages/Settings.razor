@page "/settings"
@layout SettingsLayout
@inject NavidexClient Api

<PageTitle>Settings · Navidex</PageTitle>


@if (_settings is null || _fetch is null || _log is null)
{
    <Loading />
}
else
{
    <h2>Songs on more than one album</h2>
    <p class="muted small">A song can be on an album and on a single, or on a deluxe edition and a compilation. This decides whether it's fetched once or for each, and so whether owning it on one album counts for the others.</p>
    <div class="card" style="padding: .75rem 1rem;">
        @foreach (var (value, label, help) in DuplicateOptions)
        {
            <div style="margin: .35rem 0;">
                <label>
                    <input type="radio" name="duplicates" checked="@(_settings.DuplicateTracks == value)" @onchange="() => _settings = _settings with { DuplicateTracks = value }" />
                    <strong>@label</strong>
                </label>
                <div class="muted small" style="margin-left: 1.6rem;">@help</div>
            </div>
        }
    </div>

    <h2>Missing view</h2>
    <div class="card" style="padding: .75rem 1rem;">
        <div class="row" style="margin: .35rem 0;">
            <span>Show</span>
            @foreach (var type in new[] { AlbumType.Album, AlbumType.Ep, AlbumType.Single, AlbumType.Broadcast, AlbumType.Other })
            {
                <label><input type="checkbox" checked="@_settings.ShownTypes.Contains(type)" @onchange="e => ToggleType(type, (bool)e.Value!)" /> @Format.TypeName(type)</label>
            }
        </div>
        <div style="margin: .35rem 0;">
            <label><input type="checkbox" checked="@_settings.HideSecondaryTypes" @onchange="e => _settings = _settings with { HideSecondaryTypes = (bool)e.Value! }" /> Hide live albums, compilations, remixes, demos, soundtracks and other secondary types</label>
        </div>
        <div style="margin: .35rem 0;">
            <label><input type="checkbox" checked="@_settings.HideUnofficial" @onchange="e => _settings = _settings with { HideUnofficial = (bool)e.Value! }" /> Hide albums that only exist as bootlegs</label>
        </div>
    </div>

    <h2>Matching</h2>
    <div class="card" style="padding: .75rem 1rem;">
        <label>
            Send fuzzy matches under
            <input type="number" min="50" max="100" step="1" style="width: 5rem;" value="@((int)Math.Round(_settings.MatchThreshold * 100))"
                   @onchange="e => _settings = _settings with { MatchThreshold = int.Parse(e.Value!.ToString()!) / 100.0 }" />
            % confidence to review
        </label>
        <div class="muted small">Applies from the next scan.</div>
        <label style="display: block; margin-top: .75rem;">
            When MusicBrainz is busy, try each album
            <input type="number" min="1" max="10" step="1" style="width: 4rem;" value="@_settings.AttemptsWhenBusy"
                   @onchange="e => _settings = _settings with { AttemptsWhenBusy = int.TryParse(e.Value?.ToString(), out var n) ? Math.Clamp(n, 1, 10) : _settings.AttemptsWhenBusy }" />
            @(_settings.AttemptsWhenBusy == 1 ? "time" : "times") before leaving it for the next scan
        </label>
        <div class="muted small">A busy album goes to the back of the queue, so MusicBrainz gets time to recover before it's tried again.</div>
    </div>

    <h2>Showing your music</h2>
    <div class="card" style="padding: .75rem 1rem;">
        <label>
            <input type="checkbox" checked="@_settings.PreferFileMetadata" @onchange="e => _settings = _settings with { PreferFileMetadata = (bool)e.Value! }" />
            Prefer your files' own tags and covers
        </label>
        <div class="muted small">
            Song titles, artists and albums show as your files' tags have them, and covers come from the files (an embedded picture, or
            one like folder.jpg beside them), wherever a file has them; the catalogue fills in the rest. Matching and what counts as missing
            still go by the catalogue. Files you exclude from matching always show as their own tags say.
        </div>
    </div>

    <h2>Fetching</h2>
    <div class="card" style="padding: .75rem 1rem;">
        <div class="field">
            <label class="field-label" for="path-template">Folder layout for new albums</label>
            <input id="path-template" type="text" style="width: 100%; max-width: 32rem;" @bind="_fetchTemplate" />
            <div class="muted small">
                A <a href="https://beets.readthedocs.io/en/stable/reference/pathformat.html" target="_blank" rel="noopener noreferrer">beets path format</a>.
                The default, <code>@FetchSettings.DefaultPathTemplate</code>, gives <code>Portishead/Dummy/11 Glory Box.opus</code>.
                A track for an album you already have goes next to that album's files instead.
                @if (_fetchTemplate != FetchSettings.DefaultPathTemplate)
                {
                    <button class="link small" @onclick="() => _fetchTemplate = FetchSettings.DefaultPathTemplate">Use the default</button>
                }
            </div>
        </div>
        <div class="field">
            <label>
                Fetch
                <input type="number" min="1" max="8" style="width: 4rem;" value="@_fetch.ParallelFetches"
                       @onchange="e => _fetch = _fetch with { ParallelFetches = Clamp(e, 1, 8, _fetch.ParallelFetches) }" />
                at once
            </label>
        </div>
        <div class="field">
            <label>
                Accept a file within
                <input type="number" min="0" max="120" style="width: 4rem;" value="@_fetch.DurationToleranceSeconds"
                       @onchange="e => _fetch = _fetch with { DurationToleranceSeconds = Clamp(e, 0, 120, _fetch.DurationToleranceSeconds) }" />
                seconds or
                <input type="number" min="0" max="50" style="width: 4rem;" value="@_fetch.DurationTolerancePercent"
                       @onchange="e => _fetch = _fetch with { DurationTolerancePercent = Clamp(e, 0, 50, _fetch.DurationTolerancePercent) }" />
                % of the song's length, whichever is more
            </label>
            <div class="muted small">A file further off is probably a different version, such as a live take or a radio edit.</div>
        </div>
        <div class="field">
            <label>
                Try
                <input type="number" min="1" max="5" style="width: 4rem;" value="@_fetch.CandidatesPerPlugin"
                       @onchange="e => _fetch = _fetch with { CandidatesPerPlugin = Clamp(e, 1, 5, _fetch.CandidatesPerPlugin) }" />
                of each source's results before moving to the next source
            </label>
        </div>
        <div class="field">
            <label>
                Keep listen-now tracks for
                <input type="number" min="5" max="10080" style="width: 5rem;" value="@_fetch.ListenNowExpiryMinutes"
                       @onchange="e => _fetch = _fetch with { ListenNowExpiryMinutes = Clamp(e, 5, 10080, _fetch.ListenNowExpiryMinutes) }" />
                minutes after they were last played
            </label>
            <div class="muted small">A track fetched to listen to, and not added to the library, is deleted after this.</div>
        </div>
    </div>

    <h2>Log</h2>
    <div class="card" style="padding: .75rem 1rem;">
        <div class="field">
            <label>
                Show the last
                <input type="number" min="1" max="90" style="width: 4.5rem;" value="@_log!.MemoryDays"
                       @onchange="e => _log = _log with { MemoryDays = Clamp(e, 1, 90, _log.MemoryDays) }" />
                days on the Log page
            </label>
        </div>
        <div class="field">
            <label>
                Keep backup files for
                <input type="number" min="1" max="3650" style="width: 5rem;" value="@_log.FileDays"
                       @onchange="e => _log = _log with { FileDays = Clamp(e, 1, 3650, _log.FileDays) }" />
                days
            </label>
            <div class="muted small">Every entry is written to a file per day under <code>data/logs</code> as it happens, so a restart loses nothing. Older files are deleted.</div>
        </div>
    </div>

    <div class="toolbar">
        <button class="primary" @onclick="SaveAsync">Save</button>
        @if (_saved) { <span class="muted small">Saved.</span> }
        @if (_saveError is not null) { <span class="error small" title="@_saveError">@_saveError</span> }
    </div>

    <p class="muted small">Plugins (sources, the media server and the catalogue) are set up under <a href="settings/plugins">Plugins</a>.</p>
}

@code {
    private LibrarySettings? _settings;
    private FetchSettings? _fetch;
    private LogSettings? _log;
    private string _fetchTemplate = "";
    private bool _saved;
    private string? _saveError;

    private static readonly (DuplicateTracks, string, string)[] DuplicateOptions =
    [
        (DuplicateTracks.KeepInAlbum, "Fetch once, keep in the album", "Owning a song anywhere counts for every album it's on. A single whose songs you have on an album shows as covered, not missing."),
        (DuplicateTracks.KeepInSingle, "Fetch once, keep in the single", "As above, but the file lives in the single's folder."),
        (DuplicateTracks.KeepBoth, "Fetch for each, keep both", "Every album is judged on its own files, so singles show as missing until you have them as singles."),
    ];

    protected override async Task OnInitializedAsync()
    {
        _settings = await Api.GetLibrarySettingsAsync();
        _fetch = await Api.GetFetchSettingsAsync();
        _log = await Api.GetLogSettingsAsync();
        _fetchTemplate = _fetch.PathTemplate;
    }

    private static int Clamp(ChangeEventArgs e, int min, int max, int current) =>
        int.TryParse(e.Value?.ToString(), out var n) ? Math.Clamp(n, min, max) : current;

    private void ToggleType(AlbumType type, bool on)
    {
        var types = _settings!.ShownTypes.Where(t => t != type).ToList();
        if (on)
            types.Add(type);
        _settings = _settings with { ShownTypes = types };
    }

    private async Task SaveAsync()
    {
        _saved = false;
        _saveError = null;
        try
        {
            await Api.SaveLibrarySettingsAsync(_settings!);
            await Api.SaveFetchSettingsAsync(_fetch! with { PathTemplate = _fetchTemplate });
            await Api.SaveLogSettingsAsync(_log!);
            _saved = true;
        }
        catch (NavidexApiException e)
        {
            _saveError = e.Message;
        }
    }
}
