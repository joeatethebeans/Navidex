@page "/log"
@implements IDisposable
@inject NavidexClient Api

<PageTitle>Log · Navidex</PageTitle>

<h1>Log</h1>
<p class="muted">What Navidex has been doing since the server started: scans, matches, catalogue updates, and anything that went wrong. Newest first.</p>

<div class="toolbar">
    <input type="search" placeholder="Filter, for example a folder or artist" @bind="_filter" @bind:event="oninput" />
    <label class="small"><input type="checkbox" @bind="_problemsOnly" /> Only warnings and errors</label>
    <span class="muted small">@Problems @(Problems == 1 ? "problem" : "problems")</span>
</div>

@if (_entries.Count == 0)
{
    <div class="empty card">Nothing yet. Scan the library and it'll show up here.</div>
}
else
{
    <div class="card log">
        @foreach (var entry in Visible.Take(Shown))
        {
            <div class="log-entry @entry.Level.ToString().ToLowerInvariant()">
                <span class="log-time muted" title="@entry.Time.ToLocalTime().ToString("F")">@entry.Time.ToLocalTime().ToString("HH:mm:ss")</span>
                <span class="log-source muted hide-narrow">@entry.Source</span>
                <span class="log-message">
                    @entry.Message
                    @if (entry.Error is not null && !entry.Message.Contains(entry.Error)) { <span class="muted"> · @entry.Error</span> }
                </span>
            </div>
        }
    </div>
    @if (Visible.Count() > Shown)
    {
        <p class="muted small">Showing the newest @Shown. Filter to narrow it down.</p>
    }
}

@code {
    private const int Kept = 5000;
    private const int Shown = 1000;

    private readonly List<LogEntry> _entries = [];
    private long _latest;
    private string _filter = "";
    private bool _problemsOnly;
    private Timer? _timer;

    private IEnumerable<LogEntry> Visible => Enumerable.Reverse(_entries)
        .Where(e => !_problemsOnly || e.Level != LogEntryLevel.Information)
        .Where(e => _filter.Length == 0 || e.Message.Contains(_filter, StringComparison.OrdinalIgnoreCase) || e.Source.Contains(_filter, StringComparison.OrdinalIgnoreCase));

    private int Problems => _entries.Count(e => e.Level != LogEntryLevel.Information);

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _timer = new Timer(_ => InvokeAsync(async () =>
        {
            await RefreshAsync();
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
    }

    private bool _refreshing;

    private async Task RefreshAsync()
    {
        // A tick can arrive while the last fetch is still out; both would add the same entries.
        if (_refreshing)
            return;
        _refreshing = true;
        try
        {
            var page = await Api.GetLogAsync(_latest);
            // The server restarted: its numbering starts again.
            if (page.Latest < _latest)
            {
                _entries.Clear();
                _latest = 0;
                page = await Api.GetLogAsync();
            }
            _entries.AddRange(page.Entries.Where(e => e.Seq > _latest));
            if (_entries.Count > Kept)
                _entries.RemoveRange(0, _entries.Count - Kept);
            _latest = page.Latest;
        }
        catch (HttpRequestException)
        {
        }
        finally
        {
            _refreshing = false;
        }
    }

    public void Dispose() => _timer?.Dispose();
}
