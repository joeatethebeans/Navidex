@page "/log"
@implements IDisposable
@inject NavidexClient Api

<PageTitle>Log · Navidex</PageTitle>

<h1>Log</h1>
<p class="muted">What Navidex has been doing: scans, matches, requests, catalogue updates, and anything that went wrong. Newest first. How far back it goes, and how long the backup files under <code>data/logs</code> are kept, is set in <a href="settings">Settings</a>.</p>

<div class="toolbar">
    <input type="search" placeholder="Filter, for example a folder or artist" @bind="_filter" @bind:event="oninput" />
    <select @bind="_source" aria-label="Source">
        <option value="">All sources</option>
        @foreach (var source in _entries.Select(e => e.Source).Distinct().Order())
        {
            <option value="@source">@source</option>
        }
    </select>
    <label class="small"><input type="checkbox" @bind="_information" /> Information</label>
    <label class="small"><input type="checkbox" @bind="_warnings" /> Warnings <span class="muted">(@Count(LogEntryLevel.Warning))</span></label>
    <label class="small"><input type="checkbox" @bind="_errors" /> Errors <span class="muted">(@Count(LogEntryLevel.Error))</span></label>
</div>

@if (_entries.Count == 0)
{
    <div class="empty card">Nothing yet. Scan the library and it'll show up here.</div>
}
else
{
    <div class="card log">
        @foreach (var entry in Visible.Take(Shown))
        {
            <div class="log-entry @entry.Level.ToString().ToLowerInvariant()">
                <span class="log-time muted" title="@entry.Time.ToLocalTime().ToString("F")">@entry.Time.ToLocalTime().ToString("HH:mm:ss")</span>
                <span class="log-source muted hide-narrow">@entry.Source</span>
                <span class="log-message">
                    @{ var whole = entry.Error is not null && !entry.Message.Contains(entry.Error) ? $"{entry.Message} · {entry.Error}" : entry.Message; }
                    @if (whole.Length > Brief && !_expanded.Contains(entry.Seq))
                    {
                        @whole[..Brief]<text>… </text><button class="link small" @onclick="() => _expanded.Add(entry.Seq)">Show all</button>
                    }
                    else
                    {
                        @whole
                    }
                </span>
            </div>
        }
    </div>
    @if (Visible.Count() > Shown)
    {
        <p class="muted small">Showing the newest @Shown. Filter to narrow it down.</p>
    }
}

@code {
    private const int Kept = 5000;
    private const int Shown = 1000;

    /// <summary>How much of a long entry shows until it's opened.</summary>
    private const int Brief = 500;

    private readonly HashSet<long> _expanded = [];

    private readonly List<LogEntry> _entries = [];
    private long _latest;
    private string _filter = "";
    private string _source = "";
    private bool _information = true;
    private bool _warnings = true;
    private bool _errors = true;
    private Timer? _timer;

    private IEnumerable<LogEntry> Visible => Enumerable.Reverse(_entries)
        .Where(e => e.Level switch
        {
            LogEntryLevel.Warning => _warnings,
            LogEntryLevel.Error => _errors,
            _ => _information,
        })
        .Where(e => _source.Length == 0 || e.Source == _source)
        .Where(e => _filter.Length == 0 || e.Message.Contains(_filter, StringComparison.OrdinalIgnoreCase) || e.Source.Contains(_filter, StringComparison.OrdinalIgnoreCase));

    private int Count(LogEntryLevel level) => _entries.Count(e => e.Level == level);

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _timer = new Timer(_ => InvokeAsync(async () =>
        {
            await RefreshAsync();
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
    }

    private bool _refreshing;

    private async Task RefreshAsync()
    {
        // A tick can arrive while the last fetch is still out; both would add the same entries.
        if (_refreshing)
            return;
        _refreshing = true;
        try
        {
            var page = await Api.GetLogAsync(_latest);
            // The server restarted: its numbering starts again.
            if (page.Latest < _latest)
            {
                _entries.Clear();
                _latest = 0;
                page = await Api.GetLogAsync();
            }
            _entries.AddRange(page.Entries.Where(e => e.Seq > _latest));
            if (_entries.Count > Kept)
                _entries.RemoveRange(0, _entries.Count - Kept);
            _latest = page.Latest;
        }
        catch (HttpRequestException)
        {
        }
        finally
        {
            _refreshing = false;
        }
    }

    public void Dispose() => _timer?.Dispose();
}
