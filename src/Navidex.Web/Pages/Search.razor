@page "/search"
@inject NavidexClient Api
@inject NavigationManager Navigation
@inject Player Player
@inject Preferences Prefs
@implements IDisposable

<PageTitle>Search · Navidex</PageTitle>

<h1>Search</h1>

@if (_file is not null)
{
    <div class="notice">
        Choosing the song for <strong>@(_file.Title ?? "(no title)")</strong> <span class="muted">· @(_file.Artist ?? "unknown artist") · @Format.Duration(_file.DurationSeconds)</span>
        <div class="muted small">@_file.Path</div>
        <div class="row" style="margin-top: .4rem;"><a class="small" href="review">Back to Review</a></div>
    </div>
}

<div class="library-bar search-bar">
    <div class="toolbar one-line">
        <input class="filter search-box" type="search" placeholder="@SearchHint" aria-label="Search" @bind="_query" @bind:event="oninput" @bind:after="TypedAsync"
               @onkeydown="KeyAsync" />
        <button class="icon-button filter-toggle @(_searchOpen ? "on" : "")" type="button" title="Search" aria-label="Search"
                aria-expanded="@(_searchOpen ? "true" : "false")" @onclick="ToggleSearch">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6" /><path d="M20 20l-4.5-4.5" /></svg>
        </button>
        <Segmented T="string" Value="_kind" Options="Kinds" OnChange="KindAsync" Label="Show" />
        <Segmented T="string" Value="_owned" Options="OwnedOptions" OnChange="v => _owned = v" Label="In your library" />
        <SortMenu Options="SortOptions" Value="@_sort" Descending="_descending" CanReverse="@(_sort != "relevance")" DirectionHint="@DirectionHint"
                  OnChange="key => _sort = key" OnReverse="() => _descending = !_descending" />
        <span class="spinner ownership-busy @(_remoteBusy || _localBusy ? "on" : "")" role="status" aria-label="@(_remoteBusy || _localBusy ? "Searching" : null)"></span>
    </div>
    @* Where there's no room for the box in the row, it shows below it, open to start with: searching is what the page is for. *@
    @if (_searchOpen)
    {
        <div class="filter-drop">
            <input type="search" placeholder="@SearchHint" aria-label="Search" @ref="_searchDrop" @bind="_query" @bind:event="oninput" @bind:after="TypedAsync"
                   @onkeydown="KeyAsync" />
        </div>
    }
</div>

@if (_results is null)
{
    @if (_searchError is not null)
    {
        <div class="notice error">@_searchError</div>
    }
    else if (_recentArtists.Count > 0 || _recent.Count > 0)
    {
        @if (_recentArtists.Count > 0)
        {
            <div class="section-head">
                <h2>Recent artists</h2>
                <button class="link small muted" @onclick="ClearRecentArtistsAsync">Clear</button>
            </div>
            <div class="tiles recent-artists">
                @foreach (var artist in _recentArtists)
                {
                    <div class="tile-wrap" @key="artist.Id">
                        <a class="tile" href="artists/@artist.Id" title="@(artist.Disambiguation is null ? artist.Name : $"{artist.Name} ({artist.Disambiguation})")"
                           @onclick="() => RememberArtistAsync(artist)">
                            <Cover Url="@artist.ImageUrl" Artist="true" />
                            <div class="tile-name">@artist.Name</div>
                            @if (artist.Disambiguation is not null) { <div class="muted small tile-sub">@artist.Disambiguation</div> }
                        </a>
                        <IconButton Icon="cancel" Class="remove tile-remove" Title="@($"Forget {artist.Name}")" OnClick="() => ForgetArtistAsync(artist)" />
                    </div>
                }
            </div>
        }
        @if (_recent.Count > 0)
        {
            <div class="section-head">
                <h2>Recent searches</h2>
                <button class="link small muted" @onclick="ClearRecentAsync">Clear</button>
            </div>
            <div class="recent-searches">
                @foreach (var recent in _recent)
                {
                    <span class="chip">
                        <a href="@SearchLink(recent)">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" /><path d="M12 8v4l2.5 2.5" /></svg>
                            <span class="ellipsis">@recent</span>
                        </a>
                        <button class="chip-remove" title="Forget this search" aria-label="Forget @recent" @onclick="() => ForgetAsync(recent)">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17" /></svg>
                        </button>
                    </span>
                }
            </div>
        }
    }
    else
    {
        <div class="empty card">
            Search MusicBrainz for an artist, album or track. Results show what you have and what you're missing, and anything can be fetched
            or listened to from here. As you type, matches from the catalogue Navidex already holds show at once.
        </div>
    }
}
else
{
    @* Using a result (opening it, playing it, fetching it) is what makes a search worth remembering. *@
    <div class="search-results" @onclick="UsedResultsAsync">
    @if (_remoteBusy)
    {
        <Loading Inline="true" Text="@(_localOnly ? "Showing what Navidex already knows; searching MusicBrainz…" : "Searching MusicBrainz…")" />
    }
    else if (_localOnly)
    {
        <div class="muted small search-note">From the catalogue Navidex already holds. Press Enter to search MusicBrainz.</div>
    }
    @if (_searchError is not null) { <div class="notice error">@_searchError</div> }
    @if (Artists.Count + Albums.Count + Tracks.Count == 0 && !_remoteBusy)
    {
        <div class="empty card">No results@(_owned != "" || _kind != "" ? " with these filters" : "").</div>
    }
    @if (_file is not null && Tracks.Count > 0)
    {
        <h2>Tracks</h2>
        @if (_error is not null) { <div class="notice error">@_error</div> }
        @TrackList(track => @<button class="primary small" disabled="@_matching" @onclick="() => MatchAsync(track)">This one</button>)
    }
@if (Artists.Count > 0)
    {
        <h2>Artists</h2>
        <div class="tiles">
            @foreach (var artist in Artists)
            {
                <a class="tile" href="artists/@artist.Id" title="@(artist.Disambiguation is null ? artist.Name : $"{artist.Name} ({artist.Disambiguation})")"
                   @onclick="() => RememberArtistAsync(new RecentArtist(artist.Id, artist.Name, artist.Disambiguation, artist.ImageUrl))">
                    <Cover Url="@artist.ImageUrl" Artist="true" />
                    <div class="tile-name">@artist.Name</div>
                    @if (artist.Disambiguation is not null) { <div class="muted small tile-sub">@artist.Disambiguation</div> }
                    @if (artist.InLibrary) { <div><span class="badge owned">In library</span></div> }
                </a>
            }
        </div>
    }
    @if (Albums.Count > 0)
    {
        <h2>Albums</h2>
        <div class="card">
            <table class="table track-list">
                <colgroup><col class="cover-col" /><col /><col class="status-col" /><col class="wide-action-col" /></colgroup>
                <tbody>
                    @foreach (var album in Albums)
                    {
                        <tr>
                            <td class="cover-col"><a href="albums/@album.Id" tabindex="-1"><Cover Url="@album.CoverUrl" /></a></td>
                            <td class="track-main">
                                <div class="ellipsis"><a href="albums/@album.Id">@album.Title</a></div>
                                <div class="muted small ellipsis">
                                    <a href="artists/@album.ArtistId">@album.ArtistCredit</a>@(Format.Year(album.FirstReleaseDate) is { Length: > 0 } year ? $" · {year}" : "") · @Format.TypeLabel(album.Type)
                                </div>
                            </td>
                            <td class="num"><StatusBadge Album="album.Status" /></td>
                            <td class="num actions">
                                @{
                                    var missing = album.Status == AlbumStatus.Missing;
                                    RenderFragment play = @<text>
                                        <IconButton Icon="@(missing ? "listen" : "play")" Title="@(missing ? "Listen: fetch it to play now, without adding it to your library" : album.Status == AlbumStatus.Partial ? "Play, fetching the tracks you don't have to listen to" : "Play")"
                                                    OnClick="() => Player.PlayAlbumAsync(album.Id)" />
                                        <IconButton Icon="queue" Title="Add to the queue" Confirm="true" OnClick="() => Player.QueueAlbumAsync(album.Id)" />
                                    </text>;
                                }
                                @if (album.Status is AlbumStatus.Missing or AlbumStatus.Partial)
                                {
                                    <FetchButton Kind="RequestKind.Album" Id="album.Id" Hint="@(missing ? "Get this album" : "Get the tracks you're missing")">@play</FetchButton>
                                }
                                else
                                {
                                    @play
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (_file is null && Tracks.Count > 0)
    {
        <h2>Tracks</h2>
        @TrackList(track => @<text>
            @if (track.Owned)
            {
                <IconButton Icon="play" Title="Play" OnClick="() => Player.PlayAsync([PlayerEntry.Owned(track)])" />
                <IconButton Icon="queue" Title="Add to the queue" Confirm="true" OnClick="() => Player.AddAsync([PlayerEntry.Owned(track)])" />
            }
            else
            {
                <FetchButton Kind="RequestKind.Track" Id="track.Id" Hint="Get it into your library">
                    <IconButton Icon="listen" Title="Listen: fetch it to play now, without adding it to your library" OnClick="() => Player.ListenAsync(track.Id)" />
                    <IconButton Icon="queue" Title="Add to the queue, fetching it to listen to" Confirm="true" OnClick="() => Player.ListenAsync(track.Id, next: true)" />
                </FetchButton>
            }
        </text>)
    }
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }

    /// <summary>A file from the Review page to choose the song for.</summary>
    [SupplyParameterFromQuery(Name = "file")] public Guid? FileId { get; set; }

    private static readonly IReadOnlyList<(string Value, string Label, string? Hint)> Kinds =
        [("", "All", null), ("artists", "Artists", "Only artists, which is quicker"), ("albums", "Albums", "Only albums, which is quicker"), ("tracks", "Tracks", "Only tracks, which is quicker")];

    private static readonly IReadOnlyList<(string Value, string Label, string? Hint)> OwnedOptions =
        [("", "All", "Whether you have it or not"), ("owned", "Owned", "Only what you have"), ("missing", "Missing", "Only what you don't have")];

    private const string SearchHint = "Artist, album or track";

    /// <summary>An artist opened from the search results, kept to open again.</summary>
    public sealed record RecentArtist(Guid Id, string Name, string? Disambiguation, string? ImageUrl);

    private static readonly IReadOnlyList<(string Key, string Label)> SortOptions = [("relevance", "Best match"), ("name", "Name"), ("year", "Year")];

    private string DirectionHint => _sort switch
    {
        "relevance" => "Best matches first",
        "year" => $"{(_descending ? "Newest" : "Oldest")} first; click to reverse",
        _ => $"Sorted {(_descending ? "Z to A" : "A to Z")}; click to reverse",
    };

    private const string RecentKey = "recentSearches";
    private const string RecentArtistsKey = "recentArtists";
    private const int RecentCount = 12;

    /// <summary>How long typing pauses before MusicBrainz is asked, too: long enough not to ask about half a word.</summary>
    private static readonly TimeSpan RemotePause = TimeSpan.FromMilliseconds(700);

    private List<RecentArtist> _recentArtists = [];
    private bool _searchOpen = true;
    private bool _focusSearch;
    private ElementReference _searchDrop;

    // The search the page has run itself, as you typed: its address changing needn't run it again.
    private string? _shown;

    private string _query = "";
    private string _kind = "";
    private string _owned = "";
    private string _sort = "relevance";
    private bool _descending;
    private SearchResults? _results;
    private bool _localOnly;
    private bool _remoteBusy;
    private bool _localBusy;
    private List<string> _recent = [];
    private ReviewItem? _file;
    private string? _error;
    private string? _searchError;
    private bool _matching;
    private CancellationTokenSource? _typing;
    private int _searches;

    private IReadOnlyList<string>? KindList => _kind.Length == 0 ? null : [_kind];

    private bool Shows(bool owned) => _owned switch { "owned" => owned, "missing" => !owned, _ => true };

    private IEnumerable<T> Sort<T>(IEnumerable<T> items, Func<T, string> name, Func<T, string?> year)
    {
        var text = StringComparer.CurrentCultureIgnoreCase;
        return _sort switch
        {
            "name" => _descending ? items.OrderByDescending(name, text) : items.OrderBy(name, text),
            "year" => _descending ? items.OrderByDescending(i => year(i) ?? "") : items.OrderBy(i => year(i) ?? "9999"),
            _ => items,
        };
    }

    private List<SearchArtist> Artists => _results is null ? [] : Sort(_results.Artists.Where(a => Shows(a.InLibrary)), a => a.Name, _ => null).ToList();

    private List<AlbumSummary> Albums => _results is null ? [] :
        Sort(_results.Albums.Where(a => Shows(a.Status is AlbumStatus.Complete or AlbumStatus.Partial)), a => a.Title, a => a.FirstReleaseDate).ToList();

    private List<SearchTrack> Tracks => _results is null ? [] : Sort(_results.Tracks.Where(t => Shows(t.Owned)), t => t.Title, _ => null).ToList();

    protected override async Task OnInitializedAsync()
    {
        _recent = await Prefs.GetAsync<List<string>>(RecentKey, []);
        _recentArtists = await Prefs.GetAsync<List<RecentArtist>>(RecentArtistsKey, []);
    }

    protected override async Task OnParametersSetAsync()
    {
        // The address followed what's being typed; what's typed may have moved on since, so leave it be.
        if (_shown is not null && (Query ?? "").Trim() == _shown)
            return;
        _shown = null;
        _query = Query ?? "";
        _file = FileId is { } fileId ? (await Api.GetReviewAsync()).FirstOrDefault(i => i.FileId == fileId) : null;
        _searchError = null;
        // What's shown (matches found while typing, say) stays until the search has something to replace it with.
        if (_query.Trim().Length > 0)
            await SearchAsync(_query.Trim());
        else
            _results = null;
    }

    // Matches from what Navidex already holds show at once. MusicBrainz is asked for artists, albums and tracks
    // separately, and each answer is added as it comes, so quick ones (artists, usually) needn't wait for the slowest:
    // what's shown keeps its place, with MusicBrainz's newer details, and the rest follows.
    private async Task SearchAsync(string text, bool remember = true)
    {
        var search = ++_searches;
        _remoteBusy = true;
        _searchError = null;
        if (remember)
            await RememberAsync(text);
        var pending = (KindList ?? AllKinds).Select(kind => Api.SearchAsync(text, [kind])).ToList();
        // What's shown may still be the last search's, kept so the page doesn't flash: the first answer replaces it.
        var ours = false;
        try
        {
            var local = await Api.SearchAsync(text, KindList, local: true);
            if (search == _searches)
            {
                _results = local;
                _localOnly = ours = true;
                StateHasChanged();
            }
        }
        catch (HttpRequestException)
        {
        }

        while (pending.Count > 0)
        {
            var done = await Task.WhenAny(pending);
            pending.Remove(done);
            if (search != _searches)
                return;
            try
            {
                var found = await done;
                _results = ours && _results is { } shown ? Merge(shown, found) : found;
                ours = true;
                _localOnly = false;
            }
            catch (HttpRequestException e)
            {
                _searchError = e.StatusCode == System.Net.HttpStatusCode.ServiceUnavailable
                    ? "MusicBrainz is busy right now, so some results may be missing. Try again in a moment."
                    : "Searching MusicBrainz failed, so some results may be missing. Try again in a moment.";
            }
            if (pending.Count > 0)
                StateHasChanged();
        }
        _localOnly = false;
        _remoteBusy = false;
    }

    private static readonly IReadOnlyList<string> AllKinds = ["artists", "albums", "tracks"];

    private static SearchResults Merge(SearchResults shown, SearchResults found) => new(
        Merge(shown.Artists, found.Artists, a => a.Id), Merge(shown.Albums, found.Albums, a => a.Id), Merge(shown.Tracks, found.Tracks, t => t.Id));

    private static List<T> Merge<T>(IReadOnlyList<T> shown, IReadOnlyList<T> found, Func<T, Guid> id)
    {
        var newer = found.ToDictionary(id);
        return [.. shown.Select(s => newer.GetValueOrDefault(id(s), s)), .. found.Where(f => shown.All(s => id(s) != id(f)))];
    }

    // As you type, what Navidex already holds; when typing pauses a little longer, MusicBrainz too, and the address
    // follows. Enter asks MusicBrainz at once.
    private async Task TypedAsync()
    {
        _typing?.Cancel();
        var text = _query.Trim();
        if (text.Length == 0)
        {
            // Cleared: back to the recent artists and searches.
            ++_searches;
            _results = null;
            _searchError = null;
            _remoteBusy = _localBusy = false;
            _shown = "";
            Navigation.NavigateTo(SearchLink(""), replace: true);
            return;
        }
        if (text.Length < 2)
            return;
        var typing = _typing = new CancellationTokenSource();
        try
        {
            await Task.Delay(250, typing.Token);
            _localBusy = true;
            StateHasChanged();
            var search = ++_searches;
            var local = await Api.SearchAsync(text, KindList, local: true, typing.Token);
            if (search != _searches)
                return;
            _results = local;
            _localOnly = true;
            _remoteBusy = false;
            _searchError = null;
            _localBusy = false;
            StateHasChanged();

            await Task.Delay(RemotePause, typing.Token);
            _shown = text;
            Navigation.NavigateTo(SearchLink(text), replace: true);
            await SearchAsync(text, remember: false);
        }
        catch (OperationCanceledException)
        {
        }
        catch (HttpRequestException)
        {
        }
        finally
        {
            if (_typing == typing)
                _localBusy = false;
        }
    }

    private async Task KeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SubmitAsync();
    }

    private void ToggleSearch()
    {
        _searchOpen = !_searchOpen;
        _focusSearch = _searchOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusSearch)
        {
            _focusSearch = false;
            await _searchDrop.FocusAsync();
        }
    }

    // Opening, playing or fetching something from the results.
    private async Task UsedResultsAsync()
    {
        var text = _query.Trim();
        if (text.Length > 0 && _recent.FirstOrDefault() != text)
            await RememberAsync(text);
    }

    private async Task RememberArtistAsync(RecentArtist artist)
    {
        _recentArtists = [artist, .. _recentArtists.Where(a => a.Id != artist.Id)];
        if (_recentArtists.Count > RecentCount)
            _recentArtists = _recentArtists[..RecentCount];
        await Prefs.SetAsync(RecentArtistsKey, _recentArtists);
    }

    private async Task ForgetArtistAsync(RecentArtist artist)
    {
        _recentArtists = _recentArtists.Where(a => a.Id != artist.Id).ToList();
        await Prefs.SetAsync(RecentArtistsKey, _recentArtists);
    }

    private async Task ClearRecentArtistsAsync()
    {
        _recentArtists = [];
        await Prefs.SetAsync(RecentArtistsKey, _recentArtists);
    }

    private async Task KindAsync(string kind)
    {
        _kind = kind;
        if (_results is not null && _query.Trim().Length > 0)
            await SearchAsync(_query.Trim());
    }

    private async Task RememberAsync(string text)
    {
        _recent = [text, .. _recent.Where(r => !string.Equals(r, text, StringComparison.OrdinalIgnoreCase))];
        if (_recent.Count > RecentCount)
            _recent = _recent[..RecentCount];
        await Prefs.SetAsync(RecentKey, _recent);
    }

    private async Task ForgetAsync(string text)
    {
        _recent = _recent.Where(r => r != text).ToList();
        await Prefs.SetAsync(RecentKey, _recent);
    }

    private async Task ClearRecentAsync()
    {
        _recent = [];
        await Prefs.SetAsync(RecentKey, _recent);
    }

    private string SearchLink(string text) => $"search?q={Uri.EscapeDataString(text)}{(_file is null ? "" : $"&file={_file.FileId}")}";

    private Task SubmitAsync()
    {
        _typing?.Cancel();
        var text = _query.Trim();
        if (text.Length == 0)
            return Task.CompletedTask;
        // The same search again (a press of Enter after typing) doesn't change the address, so run it here.
        if (text == (Query ?? "").Trim())
            return _shown == text && !_remoteBusy && _searchError is null ? RememberAsync(text) : SearchAsync(text);
        Navigation.NavigateTo(SearchLink(text));
        return Task.CompletedTask;
    }

    public void Dispose() => _typing?.Cancel();

    /// <summary>
    /// Tracks as the library lists them, with their album's cover and what can be done with each; and whether you have
    /// them, unless a file's song is being chosen.
    /// </summary>
    private RenderFragment TrackList(RenderFragment<SearchTrack> actions) => __builder =>
    {
        <div class="card">
            <table class="table track-list">
                <colgroup>
                    <col class="cover-col" /><col /><col class="length-col hide-narrow" />
                    @if (_file is null) { <col class="status-col" /> }
                    <col class="wide-action-col" />
                </colgroup>
                <tbody>
                    @foreach (var track in Tracks)
                    {
                        <tr>
                            <td class="cover-col">
                                @if (track.AlbumId is { } albumId) { <a href="albums/@albumId" tabindex="-1"><Cover Url="@track.CoverUrl" /></a> }
                                else { <Cover Url="@track.CoverUrl" /> }
                            </td>
                            <td class="track-main">
                                <div class="ellipsis">@track.Title</div>
                                <div class="muted small ellipsis">
                                    @if (track.ArtistId is { } artistId) { <a href="artists/@artistId">@track.ArtistCredit</a> } else { @track.ArtistCredit }
                                    @if (track.AlbumId is { } id) { <span> · <a href="albums/@id">@track.AlbumTitle</a></span> }
                                </div>
                            </td>
                            <td class="num muted hide-narrow">@Format.Duration(track.DurationSeconds)</td>
                            @if (_file is null)
                            {
                                <td class="num"><StatusBadge Track="track.Owned ? TrackStatus.Owned : TrackStatus.Missing" /></td>
                            }
                            <td class="num actions">@actions(track)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    };

    private async Task MatchAsync(SearchTrack track)
    {
        _matching = true;
        _error = null;
        try
        {
            await Api.MatchFileAsync(_file!.FileId, new MatchFile(track.Id));
            Navigation.NavigateTo("review");
        }
        catch (NavidexApiException e)
        {
            _error = e.Message;
        }
        _matching = false;
    }
}
