@page "/review"
@inject NavidexClient Api

<PageTitle>Review · Navidex</PageTitle>

<h1>Review</h1>
<p class="muted">Files Navidex couldn't match confidently. They don't count as owned until they're matched. Accepting and rematching come with the Review page in Phase 2; for now, fixing a file's tags and scanning again works.</p>

@if (_items is null)
{
    <p class="muted">Loading…</p>
}
else if (_items.Count == 0)
{
    <div class="empty card">Nothing to review.</div>
}
else
{
    <div class="toolbar">
        <input type="search" placeholder="Filter, for example a title, artist or folder" @bind="_filter" @bind:event="oninput" />
    </div>
    @if (!Visible.Any())
    {
        <div class="empty card">Nothing to review matches that filter.</div>
    }
    <div class="card">
        <table class="table">
            <thead>
                <tr>
                    <th>File</th>
                    <th>Why</th>
                    <th class="hide-narrow">Best guess</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Visible)
                {
                    <tr>
                        <td>
                            <div>@(item.Title ?? "(no title)") <span class="muted">· @(item.Artist ?? "unknown artist")</span></div>
                            <div class="muted small">@item.Path · @Format.Duration(item.DurationSeconds)</div>
                        </td>
                        <td class="small">@item.Reason</td>
                        <td class="small hide-narrow">
                            @if (item.Suggestion is { } s)
                            {
                                <div>@s.Title <span class="muted">· @s.ArtistCredit · @Format.Duration(s.DurationSeconds)</span></div>
                                @if (s.AlbumId is { } albumId) { <a href="albums/@albumId">@s.AlbumTitle</a> }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<ReviewItem>? _items;
    private string _filter = "";

    private IEnumerable<ReviewItem> Visible => _items!.Where(i => _filter.Length == 0
        || new[] { i.Path, i.Title, i.Artist, i.Album, i.Suggestion?.Title, i.Suggestion?.AlbumTitle }
            .Any(text => text?.Contains(_filter, StringComparison.OrdinalIgnoreCase) == true));

    protected override async Task OnInitializedAsync() => _items = await Api.GetReviewAsync();
}
