@*
    Artwork for an artist or album. It shimmers while the picture is fetched, and shows a placeholder icon only if
    there's no artwork or it doesn't load. Fills its container's width.
*@
<div @key="Url" class="cover @(Artist ? "artist" : "album") @(Url is null ? "empty" : "pending") @Class" aria-hidden="true">
    @if (Artist)
    {
        <svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="4" /><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7" /></svg>
    }
    else
    {
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="2.5" /></svg>
    }
    @if (Url is not null)
    {
        @* The classes are set by the browser as the picture arrives; Blazor leaves them alone until the URL changes. *@
        <img src="@Url" alt="" loading="lazy"
             onload="this.parentElement.classList.replace('pending', 'loaded')"
             onerror="this.parentElement.classList.replace('pending', 'empty'); this.remove()" />
    }
</div>

@code {
    [Parameter] public string? Url { get; set; }
    [Parameter] public bool Artist { get; set; }
    [Parameter] public string? Class { get; set; }
}
