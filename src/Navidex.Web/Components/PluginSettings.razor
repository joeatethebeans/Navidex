@using Navidex.Contracts.Plugins
@inject NavidexClient Api

@* Plugins, by type: where music comes from (in fallback order), the media server to tell, and the catalogue. *@
@if (_plugins is null)
{
    <p class="muted">Loading…</p>
}
else
{
    @if (_error is not null) { <div class="notice error">@_error</div> }

    <h3>Sources</h3>
    <p class="muted small">Retrieval plugins run in their own containers. A request tries them in this order, moving to the next when one finds nothing that passes the checks.</p>
    <div class="card">
        @foreach (var plugin in OfType(PluginType.Retrieval))
        {
            @Row(plugin)
        }
        <form class="plugin-add" @onsubmit="AddRetrievalAsync">
            <input type="text" placeholder="Plugin URL, for example http://retriever-ytdlp:8080" @bind="_endpoint" />
            <button type="submit" disabled="@(_busy || string.IsNullOrWhiteSpace(_endpoint))">Add</button>
        </form>
    </div>

    <h3>Media server</h3>
    <p class="muted small">Told to scan when music is filed, so it shows up there. The first enabled one is used.</p>
    <div class="card">
        @foreach (var plugin in OfType(PluginType.Connector))
        {
            @Row(plugin)
        }
        @AddBuiltIn(PluginType.Connector)
    </div>

    <h3>Catalogue</h3>
    <div class="card">
        @foreach (var plugin in OfType(PluginType.Index))
        {
            @Row(plugin)
        }
    </div>
}

@code {
    private IReadOnlyList<PluginInfo>? _plugins;
    private IReadOnlyList<AvailablePlugin> _available = [];
    private string _endpoint = "";
    private string? _error;
    private bool _busy;

    private Guid? _editing;
    private SchemaForm? _editForm;
    private string? _adding;
    private SchemaForm? _addForm;

    private IEnumerable<PluginInfo> OfType(PluginType type) => _plugins!.Where(p => p.Type == type).OrderBy(p => p.Priority);

    protected override async Task OnInitializedAsync()
    {
        _available = await Api.ListAvailablePluginsAsync();
        await LoadAsync();
    }

    private async Task LoadAsync() => _plugins = await Api.ListPluginsAsync();

    private RenderFragment Row(PluginInfo plugin) => __builder =>
    {
        var list = OfType(plugin.Type).ToList();
        var index = list.IndexOf(plugin);
        <div class="plugin @(plugin.Enabled ? "" : "dim")">
            <div class="plugin-head">
                <div class="plugin-name">
                    <strong>@plugin.Name</strong>
                    <div class="muted small">@(plugin.Endpoint ?? plugin.Manifest?.Description) @(plugin.Manifest is { } m ? $"· v{m.Version}" : "")</div>
                </div>
                <span class="badge @HealthBadge(plugin.Health)" title="@plugin.HealthMessage">@HealthLabel(plugin.Health)</span>
                <span class="spacer"></span>
                <div class="actions">
                    @if (plugin.Type == PluginType.Retrieval)
                    {
                        <button class="link small" title="Try earlier" disabled="@(index == 0)" @onclick="() => MoveAsync(plugin, -1)">↑</button>
                        <button class="link small" title="Try later" disabled="@(index == list.Count - 1)" @onclick="() => MoveAsync(plugin, 1)">↓</button>
                    }
                    <label class="small"><input type="checkbox" checked="@plugin.Enabled" @onchange="e => SetEnabledAsync(plugin, (bool)e.Value!)" /> On</label>
                    <button class="link small" disabled="@_busy" @onclick="() => TestAsync(plugin)">Test</button>
                    <button class="link small" @onclick="() => _editing = _editing == plugin.Id ? null : plugin.Id">Settings</button>
                    @if (plugin.Type != PluginType.Index)
                    {
                        <button class="link small" @onclick="() => RemoveAsync(plugin)">Remove</button>
                    }
                </div>
            </div>
            @if (plugin.HealthMessage is not null && plugin.Health != HealthStatus.Healthy)
            {
                <div class="small plugin-message">@plugin.HealthMessage</div>
            }
            @if (_editing == plugin.Id)
            {
                <div class="plugin-form">
                    <SchemaForm @ref="_editForm" Schema="plugin.Manifest?.SettingsSchema" Settings="plugin.Settings" HasSaved="true" />
                    <div class="row">
                        <button class="primary" disabled="@_busy" @onclick="() => SaveAsync(plugin)">Save and test</button>
                        <button @onclick="() => _editing = null">Close</button>
                    </div>
                </div>
            }
        </div>
    };

    private RenderFragment AddBuiltIn(PluginType type) => __builder =>
    {
        var choices = _available.Where(a => a.Manifest.Type == type && a.Problem is null).ToList();
        if (choices.Count == 0)
            return;
        if (_adding is { } id && choices.FirstOrDefault(c => c.Manifest.Id == id) is { } chosen)
        {
            <div class="plugin plugin-form">
                <strong>Add @chosen.Manifest.Name</strong>
                <SchemaForm @ref="_addForm" Schema="chosen.Manifest.SettingsSchema" />
                <div class="row">
                    <button class="primary" disabled="@_busy" @onclick="() => AddBuiltInAsync(chosen)">Add and test</button>
                    <button @onclick="() => _adding = null">Cancel</button>
                </div>
            </div>
        }
        else
        {
            <div class="plugin-add">
                @foreach (var choice in choices)
                {
                    <button @onclick="() => _adding = choice.Manifest.Id">Add @choice.Manifest.Name</button>
                }
            </div>
        }
    };

    private async Task AddRetrievalAsync()
    {
        await RunAsync(async () =>
        {
            var added = await Api.AddPluginAsync(new AddPlugin(Endpoint: _endpoint.Trim()));
            _endpoint = "";
            await Api.TestPluginAsync(added.Id);
        });
    }

    private Task AddBuiltInAsync(AvailablePlugin plugin) => RunAsync(async () =>
    {
        var added = await Api.AddPluginAsync(new AddPlugin(PluginId: plugin.Manifest.Id, Settings: _addForm!.ToJson()));
        _adding = null;
        await Api.TestPluginAsync(added.Id);
    });

    private Task SaveAsync(PluginInfo plugin) => RunAsync(async () =>
    {
        await Api.UpdatePluginAsync(plugin.Id, new UpdatePlugin(Settings: _editForm!.ToJson()));
        _editing = null;
        await Api.TestPluginAsync(plugin.Id);
    });

    private Task TestAsync(PluginInfo plugin) => RunAsync(() => Api.TestPluginAsync(plugin.Id));

    private Task SetEnabledAsync(PluginInfo plugin, bool enabled) => RunAsync(() => Api.UpdatePluginAsync(plugin.Id, new UpdatePlugin(Enabled: enabled)));

    private Task RemoveAsync(PluginInfo plugin) => RunAsync(() => Api.RemovePluginAsync(plugin.Id));

    private Task MoveAsync(PluginInfo plugin, int by) => RunAsync(() =>
    {
        var order = OfType(plugin.Type).Select(p => p.Id).ToList();
        var from = order.IndexOf(plugin.Id);
        order.RemoveAt(from);
        order.Insert(from + by, plugin.Id);
        return Api.OrderPluginsAsync(order);
    });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
        }
        catch (NavidexApiException e)
        {
            _error = e.Message;
        }
        await LoadAsync();
        _busy = false;
    }

    private static string HealthBadge(HealthStatus? health) => health switch
    {
        HealthStatus.Healthy => "owned",
        HealthStatus.Degraded => "partial",
        HealthStatus.Unhealthy => "missing",
        _ => "neutral",
    };

    private static string HealthLabel(HealthStatus? health) => health switch
    {
        HealthStatus.Healthy => "Working",
        HealthStatus.Degraded => "Partly working",
        HealthStatus.Unhealthy => "Not working",
        _ => "Not tested",
    };
}
