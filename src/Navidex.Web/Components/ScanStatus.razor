@implements IDisposable
@inject NavidexClient Api

@* Shows the scan button, or what the running task is doing. Polls while a task runs. *@
<div class="row small">
    @if (_status?.CurrentTask is { } task)
    {
        <a class="muted" href="log" title="See the log">@(task.Progress ?? "Starting…")</a>
    }
    else if (_status?.LastScan is { State: TaskState.Failed } failed)
    {
        <a class="error" href="log" title="@failed.Error">Scan failed: @failed.Error</a>
    }
    else if (_status is not null)
    {
        <span class="muted hide-narrow" title="@_status.LastScan?.Progress">@_status.Files files@(_status.Review > 0 ? $", {_status.Review} to review" : "")</span>
    }
    <button class="primary" disabled="@(_status?.CurrentTask is not null)" @onclick="ScanAsync">Scan library</button>
</div>

@code {
    private LibraryStatus? _status;
    private Timer? _timer;
    private bool _wasRunning;
    private int _polls;

    /// <summary>
    /// Raised every 15 seconds while a task runs and once when it finishes, so pages can reload: artists show up as
    /// their files are matched, not only at the end of a long scan.
    /// </summary>
    public static event Action? LibraryChanged;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _timer = new Timer(_ => InvokeAsync(RefreshAsync), null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    private async Task RefreshAsync()
    {
        try
        {
            _status = await Api.GetLibraryStatusAsync();
        }
        catch (HttpRequestException)
        {
            return;
        }
        var running = _status?.CurrentTask is not null;
        if (_wasRunning && !running || running && ++_polls % 5 == 0)
            LibraryChanged?.Invoke();
        _wasRunning = running;
        StateHasChanged();
    }

    private async Task ScanAsync()
    {
        await Api.ScanLibraryAsync();
        await RefreshAsync();
    }

    public void Dispose() => _timer?.Dispose();
}
