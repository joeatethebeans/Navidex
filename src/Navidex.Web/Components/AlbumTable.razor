@* A list of albums with their status. *@
@inject Player Player

<div class="card">
    <table class="table albums">
        <thead>
            <tr>
                <th class="cover-col"></th>
                <th>Title</th>
                <th class="hide-narrow">Year</th>
                <th>Status</th>
                <th class="num hide-narrow">Tracks</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var album in Albums)
            {
                <tr class="@(album.Ignored ? "dim" : "")">
                    <td class="cover-col"><a href="albums/@album.Id" tabindex="-1"><Cover Url="@album.CoverUrl" /></a></td>
                    <td>
                        <a href="albums/@album.Id">@album.Title</a>
                        @if (ShowSecondary && album.SecondaryTypes.Count > 0)
                        {
                            <span class="muted small"> · @Format.Secondary(album.SecondaryTypes)</span>
                        }
                    </td>
                    <td class="hide-narrow muted">@Format.Year(album.FirstReleaseDate)</td>
                    <td><StatusBadge Album="album.Status" /></td>
                    <td class="num hide-narrow muted">@Format.Tracks(album)</td>
                    <td class="num actions">
                        @{
                            var missing = album.Status == AlbumStatus.Missing;
                            RenderFragment play = @<text>
                                <IconButton Icon="@(missing ? "listen" : "play")" Title="@(missing ? "Listen: fetch it to play now, without adding it to your library" : album.Status == AlbumStatus.Partial ? "Play, fetching the tracks you don't have to listen to" : "Play")"
                                            OnClick="() => Player.PlayAlbumAsync(album.Id)" />
                                <IconButton Icon="queue" Title="Add to the queue" Confirm="true" OnClick="() => Player.QueueAlbumAsync(album.Id)" />
                            </text>;
                        }
                        @if (album.Ignored)
                        {
                            <IconButton Icon="unignore" Title="Unignore: count this album again" OnClick="() => OnIgnore.InvokeAsync(album)" />
                        }
                        else if (album.Status is AlbumStatus.Partial or AlbumStatus.Missing)
                        {
                            <FetchButton Kind="RequestKind.Album" Id="album.Id" Hint="@(album.Status == AlbumStatus.Partial ? "Get the tracks you're missing" : "Get this album")">
                                @play
                                @if (missing)
                                {
                                    <IconButton Icon="ignore" Title="Ignore: stop counting this album as missing" OnClick="() => OnIgnore.InvokeAsync(album)" />
                                }
                            </FetchButton>
                        }
                        else
                        {
                            @play
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AlbumSummary> Albums { get; set; } = [];
    [Parameter] public EventCallback<AlbumSummary> OnIgnore { get; set; }
    [Parameter] public bool ShowSecondary { get; set; }
}
