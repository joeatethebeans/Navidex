@* One thing a retrieval plugin offered: what it is, where from, and how good a match the plugin thinks it is. *@
<span>@Value.Title</span>
<span class="muted">
    @if (Value.Artist is not null) { <span> · @Value.Artist</span> }
    @if (Value.Album is not null) { <span> · @Value.Album</span> }
    <span> · @Format.Duration(Value.DurationSeconds)</span>
    <span> · @(Value.Url is null ? Value.Source : "")</span>
    @if (Value.Url is not null) { <a href="@Value.Url" target="_blank" rel="noopener noreferrer">@Value.Source</a> }
    @if (Value.Format is not null) { <span> · @Value.Format@(Value.BitrateKbps is { } kbps ? $" {kbps} kbps" : "")</span> }
    @if (Value.Score is { } score) { <span> · @score.ToString("P0") match</span> }
</span>

@code {
    [Parameter, EditorRequired] public JobCandidate Value { get; set; } = null!;
}
