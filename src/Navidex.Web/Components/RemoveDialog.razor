@inject NavidexClient Api

@*
    Asks before removing an artist, album or file from the library, saying what it covers and offering to delete the
    files or keep them and stop counting them.
*@
<div class="dialog-backdrop" @onclick="CancelAsync">
    <div class="dialog" role="alertdialog" aria-modal="true" aria-labelledby="remove-title" @onclick:stopPropagation="true"
         @onkeydown="KeyAsync" tabindex="-1" @ref="_dialog">
        <h2 id="remove-title">Remove @Name from your library?</h2>

        @if (_result is { } result)
        {
            <p>
                @(_delete ? $"Deleted {Format.Count(result.Removed, "file", "files")}." : $"Removed {Format.Count(result.Removed, "file", "files")}; they're still in your music folder.")
            </p>
            @if (result.Failed.Count > 0)
            {
                <p class="error">Couldn't delete @Format.Count(result.Failed.Count, "file", "files"), so @(result.Failed.Count == 1 ? "it stays" : "they stay") in the library:</p>
                <ul class="small dialog-list">
                    @foreach (var failure in result.Failed.Take(10)) { <li>@failure</li> }
                </ul>
            }
            <div class="toolbar dialog-buttons">
                <button class="primary" @onclick="() => OnClose.InvokeAsync(true)">Close</button>
            </div>
        }
        else if (_preview is null)
        {
            @if (_error is not null) { <p class="error">@_error</p> } else { <Loading Inline="true" /> }
        }
        else if (_preview.Files == 0)
        {
            <p>There are no files of @Name in the library, so there's nothing to remove.</p>
            <div class="toolbar dialog-buttons"><button @onclick="CancelAsync">Close</button></div>
        }
        else
        {
            <p>
                That's @Format.Count(_preview.Files, "file", "files") (@Format.Size(_preview.Bytes))
                @(_preview.Folders.Count == 1 ? "in" : $"in {_preview.Folders.Count}{(_preview.Folders.Count == 20 ? " or more" : "")} folders, including"):
            </p>
            <ul class="small dialog-list">
                @foreach (var folder in _preview.Folders.Take(4)) { <li><code>@(folder.Length == 0 ? "(the music folder)" : folder)</code></li> }
            </ul>

            <label class="dialog-choice">
                <input type="radio" name="remove-how" checked="@(!_delete)" @onchange="() => _delete = false" />
                <span>
                    <strong>Keep the files</strong>
                    <span class="muted small">
                        They stay in your music folder and your media server, but Navidex stops counting them, so they show as missing.
                        They're hidden: you can bring them back from the hidden files on the Review page.
                    </span>
                </span>
            </label>
            <label class="dialog-choice @(_preview.CanDelete ? "" : "disabled")">
                <input type="radio" name="remove-how" checked="@_delete" disabled="@(!_preview.CanDelete)" @onchange="() => _delete = true" />
                <span>
                    <strong>Delete the files</strong>
                    <span class="muted small">
                        @if (_preview.CanDelete)
                        {
                            <span>
                                They're deleted from your music folder, along with any folder left holding only artwork, playlists or rip logs,
                                and your media server is told. This can't be undone.
                            </span>
                        }
                        else
                        {
                            <span>Can't delete them now: @(_preview.CantDeleteReason?.TrimEnd('.') ?? "the import worker, which writes the music folder, isn't working").</span>
                        }
                    </span>
                </span>
            </label>

            @if (_error is not null) { <p class="error small">@_error</p> }
            <div class="toolbar dialog-buttons">
                <button @onclick="CancelAsync" disabled="@_busy">Cancel</button>
                <button class="danger" @onclick="RemoveAsync" disabled="@_busy">
                    @if (_busy) { <span class="spinner"></span> }
                    @(_delete ? $"Delete {Format.Count(_preview.Files, "file", "files")}" : "Remove, keep the files")
                </button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public LibraryItemKind Kind { get; set; }
    [Parameter, EditorRequired] public Guid Id { get; set; }

    /// <summary>What's being removed, as the title should say it, such as <c>Dummy by Portishead</c>.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    /// <summary>Called with whether anything was removed.</summary>
    [Parameter] public EventCallback<bool> OnClose { get; set; }

    private ElementReference _dialog;
    private RemovalPreview? _preview;
    private RemovalResult? _result;
    private bool _delete;
    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _preview = await Api.GetRemovalAsync(Kind, Id);
        }
        catch (Exception e) when (e is HttpRequestException or NavidexApiException)
        {
            _error = $"Couldn't see what it covers: {e.Message}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await _dialog.FocusAsync();
    }

    private async Task KeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            await CancelAsync();
    }

    private Task CancelAsync() => _busy ? Task.CompletedTask : OnClose.InvokeAsync(_result is not null);

    private async Task RemoveAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            _result = await Api.RemoveFromLibraryAsync(new RemoveFromLibrary(Kind, Id, _delete));
            if (_result.Failed.Count == 0)
            {
                _busy = false;
                await OnClose.InvokeAsync(true);
                return;
            }
        }
        catch (Exception e) when (e is HttpRequestException or NavidexApiException)
        {
            _error = e.Message;
        }
        _busy = false;
    }
}
